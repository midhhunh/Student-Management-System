<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Class Teacher Dashboard | EduManage</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #3730a3;
            --navy: #172554;
            --background: #f4f6fb;
            --surface: #ffffff;
            --text: #1e293b;
            --muted: #64748b;
            --border: #e5eaf2;
            --success: #059669;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--background);
            color: var(--text);
            font-family: 'Inter', sans-serif;
        }

        /* Navbar */

        .custom-navbar {
            background: linear-gradient(110deg, #172554, #312e81, #4f46e5);
            padding: 14px 0;
            box-shadow: 0 5px 22px rgba(15, 23, 42, .13);
        }

        .navbar-brand {
            color: #fff !important;
            font-size: 21px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .logo-icon {
            margin-right: 7px;
        }

        .navbar .nav-link {
            color: rgba(255, 255, 255, .83);
            font-size: 14px;
            font-weight: 600;
            padding: 10px 13px !important;
            transition: .2s;
        }

        .navbar .nav-link:hover {
            color: #fff;
        }

        .registration-btn {
            background: #fbbf24;
            color: #422006;
            border: none;
            border-radius: 9px;
            padding: 9px 15px;
            font-size: 13px;
            font-weight: 700;
        }

        .registration-btn:hover {
            background: #f59e0b;
            color: #422006;
        }

        .btn-logout {
            border: 1px solid rgba(255, 255, 255, .55);
            color: #fff;
            border-radius: 9px;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
        }

        .btn-logout:hover {
            color: var(--navy);
            background: #fff;
        }

        /* Main layout */

        .page-container {
            max-width: 1350px;
            padding-top: 32px;
            padding-bottom: 45px;
        }

        /* Welcome banner */

        .welcome-card {
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            gap: 22px;
            padding: 34px;
            margin-bottom: 30px;
            border-radius: 22px;
            color: #fff;
            background: linear-gradient(115deg, #1e1b4b, #4338ca, #6366f1);
            box-shadow: 0 14px 32px rgba(79, 70, 229, .18);
        }

        .welcome-card::before,
        .welcome-card::after {
            content: "";
            position: absolute;
            border: 35px solid rgba(255, 255, 255, .06);
            border-radius: 50%;
            pointer-events: none;
        }

        .welcome-card::before {
            width: 250px;
            height: 250px;
            right: -70px;
            top: -130px;
        }

        .welcome-card::after {
            width: 150px;
            height: 150px;
            right: 170px;
            bottom: -115px;
        }

        .teacher-avatar {
            width: 78px;
            height: 78px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 22px;
            background: rgba(255, 255, 255, .16);
            border: 1px solid rgba(255, 255, 255, .24);
            font-size: 37px;
        }

        .welcome-content {
            position: relative;
            z-index: 1;
        }

        .welcome-label {
            display: inline-block;
            margin-bottom: 8px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.5px;
            color: #c7d2fe;
        }

        .welcome-card h1 {
            font-size: clamp(1.5rem, 4vw, 2.2rem);
            font-weight: 800;
            margin-bottom: 8px;
            overflow-wrap: anywhere;
        }

        .welcome-card p {
            color: rgba(255, 255, 255, .83);
            font-size: 14px;
            margin-bottom: 15px;
        }

        .class-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 15px;
            border-radius: 30px;
            background: rgba(255, 255, 255, .15);
            border: 1px solid rgba(255, 255, 255, .17);
            font-size: 13px;
            font-weight: 700;
        }

        /* Section cards */

        .section-card {
            height: 100%;
            padding: 25px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 17px;
            box-shadow: 0 5px 20px rgba(15, 23, 42, .035);
            transition: .25s ease;
        }

        .section-card:hover {
            box-shadow: 0 12px 28px rgba(15, 23, 42, .065);
        }

        .section-heading {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 17px;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .heading-icon {
            width: 43px;
            height: 43px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 13px;
            background: #eef2ff;
            color: var(--primary);
            font-size: 20px;
        }

        .section-description {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 22px;
        }

        .form-label {
            color: #334155;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .form-control,
        .form-select {
            min-height: 45px;
            border: 1px solid #dce3ed;
            border-radius: 10px;
            font-size: 13px;
            box-shadow: none;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #818cf8;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, .12);
        }

        .btn {
            border-radius: 9px;
            font-size: 13px;
            font-weight: 700;
            transition: .2s;
        }

        .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            border-color: var(--primary-dark);
            transform: translateY(-1px);
        }

        .btn-success {
            background: #059669;
            border-color: #059669;
        }

        .btn-success:hover {
            background: #047857;
            border-color: #047857;
        }

        /* Invitation success */

        .invitation-box {
            margin-top: 20px;
            padding: 17px;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            border-radius: 12px;
        }

        .invitation-box h5 {
            color: #047857;
            font-size: 15px;
            font-weight: 800;
        }

        .invitation-box p {
            font-size: 13px;
            color: #334155;
            margin-bottom: 9px;
            overflow-wrap: anywhere;
        }

        /* General section headings */

        .content-section {
            margin-top: 38px;
        }

        .section-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 20px;
        }

        .section-top h2 {
            font-size: 21px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .section-top p {
            color: var(--muted);
            font-size: 13px;
            margin: 0;
        }

        .section-title-icon {
            color: var(--primary);
            margin-right: 7px;
        }

        /* Exam cards */

        .exam-card {
            height: 100%;
            padding: 21px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(15, 23, 42, .035);
            transition: .22s;
        }

        .exam-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(15, 23, 42, .075);
        }

        .exam-card-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 17px;
        }

        .exam-icon {
            width: 43px;
            height: 43px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            background: #eef2ff;
            color: var(--primary);
            font-size: 20px;
        }

        .exam-card h3 {
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 14px;
            overflow-wrap: anywhere;
        }

        .exam-detail {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            color: var(--muted);
            font-size: 12px;
            margin-bottom: 10px;
        }

        .exam-detail i {
            color: #818cf8;
            font-size: 15px;
        }

        .exam-actions {
            display: grid;
            gap: 9px;
            margin-top: 17px;
        }

        .badge {
            padding: 7px 11px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 700;
        }

        /* Student section */

        .student-count {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-top: 8px;
            padding: 6px 11px;
            color: #4338ca;
            background: #eef2ff;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 700;
        }

        .search-box {
            position: relative;
            width: 100%;
            max-width: 340px;
        }

        .search-box i {
            position: absolute;
            top: 50%;
            left: 14px;
            transform: translateY(-50%);
            color: #94a3b8;
        }

        .search-box input {
            padding-left: 40px;
            background: #fff;
        }

        /* Student cards */

        .student-card {
            height: 100%;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 17px;
            box-shadow: 0 5px 18px rgba(15, 23, 42, .04);
            transition: .23s ease;
        }

        .student-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 28px rgba(15, 23, 42, .08);
        }

        .student-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 19px 20px 0;
        }

        .student-avatar {
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            border-radius: 15px;
            color: var(--primary);
            background: #eef2ff;
            font-size: 26px;
        }

        .student-info {
            padding: 17px 20px 15px;
        }

        .student-info h3 {
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 9px;
            overflow-wrap: anywhere;
        }

        .register-number {
            color: var(--muted);
            font-size: 12px;
            overflow-wrap: anywhere;
            margin-bottom: 12px;
        }

        .student-class {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 11px;
            color: #334155;
            background: #f1f5f9;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
        }

        .student-divider {
            height: 1px;
            margin: 0 20px;
            background: var(--border);
        }

        .student-tools {
            padding: 16px 20px;
        }

        .student-tools-title {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 12px;
            font-weight: 800;
            color: #475569;
            margin-bottom: 11px;
        }

        .student-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .student-actions form {
            margin: 0;
        }

        /* Marks form */

        .marks-form {
            margin: 0 18px 14px;
            padding: 15px;
            background: #f8fafc;
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .marks-form h5 {
            font-size: 13px;
            font-weight: 800;
            margin-bottom: 7px;
        }

        .marks-form p {
            font-size: 11px;
        }

        .marks-form .form-label {
            font-size: 11px;
            margin-bottom: 5px;
        }

        .marks-form .form-control {
            min-height: 39px;
            margin-bottom: 11px;
        }

        .view-profile {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin: 0 18px 18px;
            padding: 11px;
            color: #4338ca;
            background: #eef2ff;
            border-radius: 10px;
            text-decoration: none;
            font-size: 12px;
            font-weight: 800;
            transition: .2s;
        }

        .view-profile:hover {
            color: #fff;
            background: var(--primary);
        }

        /* Empty states */

        .empty-state {
            padding: 42px 20px;
            text-align: center;
            background: #fff;
            border: 1px dashed #cbd5e1;
            border-radius: 17px;
            color: var(--muted);
        }

        .empty-state i {
            display: block;
            margin-bottom: 13px;
            color: #818cf8;
            font-size: 40px;
        }

        .empty-state h4 {
            color: var(--text);
            font-size: 17px;
            font-weight: 800;
        }

        .empty-state p {
            font-size: 13px;
        }

        .footer-text {
            margin-top: 42px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
            text-align: center;
            color: #94a3b8;
            font-size: 12px;
        }

        @media (max-width: 575px) {
            .page-container {
                padding-top: 20px;
            }

            .welcome-card {
                align-items: flex-start;
                padding: 23px 18px;
                gap: 14px;
            }

            .teacher-avatar {
                width: 55px;
                height: 55px;
                border-radius: 15px;
                font-size: 27px;
            }

            .section-card {
                padding: 20px;
            }

            .section-top {
                align-items: stretch;
            }

            .search-box {
                max-width: none;
            }

            .section-top h2 {
                font-size: 19px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVIGATION -->
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
        <div class="container">

            <a class="navbar-brand" href="/teacher/home">
                <span class="logo-icon">🎓</span> EduManage
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#teacherNavbar"
                aria-controls="teacherNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="teacherNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link" href="/teacher/dashboard">
                            <i class="bi bi-person-circle me-1"></i>
                            My Profile
                        </a>
                    </li>

                    <li class="nav-item ms-lg-2 my-2 my-lg-0">
                        <a href="/teacher/registration-status" class="btn registration-btn">
                            <i class="bi bi-person-exclamation me-1"></i>
                            Registration Status
                        </a>
                    </li>

                    <li class="nav-item ms-lg-3 my-2 my-lg-0">
                        <a href="/teacher/logout" class="btn btn-logout">
                            <i class="bi bi-box-arrow-right me-1"></i>
                            Logout
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>


    <main class="container page-container">

        <!-- WELCOME BANNER -->
        <section class="welcome-card">

            <div class="teacher-avatar">
                <i class="bi bi-person-workspace"></i>
            </div>

            <div class="welcome-content">

                <span class="welcome-label">TEACHER PORTAL</span>

                <h1>
                    Welcome,
                    <%= typeof teacher !=='undefined' && teacher.name ? teacher.name : 'Teacher' %>!
                </h1>

                <p>
                    Manage your classroom, examinations, student records and academic performance.
                </p>

                <span class="class-badge">
                    <i class="bi bi-mortarboard-fill"></i>
                    Assigned Class:
                    <%= typeof teacher !=='undefined' && teacher.class ? teacher.class : 'Not assigned' %>
                </span>

            </div>
        </section>


        <!-- QUICK ACTIONS -->
        <div class="row g-4">

            <!-- CREATE EXAM -->
            <div class="col-12 col-lg-6">
                <section class="section-card">

                    <h2 class="section-heading">
                        <span class="heading-icon">
                            <i class="bi bi-journal-plus"></i>
                        </span>
                        Create New Exam
                    </h2>

                    <p class="section-description">
                        Schedule a new examination for your assigned class.
                    </p>

                    <form action="/teacher/exams/create" method="POST">

                        <div class="mb-3">
                            <label class="form-label">Exam Name</label>

                            <select name="exam_name" class="form-select" required>
                                <option value="">Select Exam</option>
                                <option value="First Term Exam">First Term Exam</option>
                                <option value="Midterm Exam">Midterm Exam</option>
                                <option value="Second Term Exam">Second Term Exam</option>
                                <option value="Model Exam">Model Exam</option>
                                <option value="Annual Exam">Annual Exam</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Academic Year</label>

                            <input type="text" name="academic_year" class="form-control" placeholder="2026-2027"
                                pattern="[0-9]{4}-[0-9]{4}" title="Enter the academic year in YYYY-YYYY format."
                                required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Exam Date</label>

                            <input type="date" name="exam_date" class="form-control">
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Total Marks</label>

                            <input type="number" name="total_marks" class="form-control" min="1" step="0.01"
                                placeholder="100" required>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">
                            <i class="bi bi-plus-circle me-2"></i>
                            Create Examination
                        </button>

                    </form>
                </section>
            </div>


            <!-- ADD STUDENT -->
            <div class="col-12 col-lg-6">
                <section class="section-card">

                    <h2 class="section-heading">
                        <span class="heading-icon">
                            <i class="bi bi-person-plus-fill"></i>
                        </span>
                        Add a Student
                    </h2>

                    <p class="section-description">
                        Generate a registration number by entering the student's email address.
                    </p>

                    <form action="/teacher/student/invite" method="POST">

                        <div class="mb-4">
                            <label for="studentEmail" class="form-label">
                                Student Email Address
                            </label>

                            <input type="email" id="studentEmail" name="email" class="form-control"
                                placeholder="student@example.com" required>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">
                            <i class="bi bi-key-fill me-2"></i>
                            Generate Registration Number
                        </button>

                    </form>

                    <% if (typeof generatedRegisterNumber !=='undefined' && generatedRegisterNumber) { %>

                        <div class="invitation-box">

                            <h5>
                                <i class="bi bi-check-circle-fill me-2"></i>
                                Invitation Created Successfully
                            </h5>

                            <p>
                                Email:
                                <strong>
                                    <%= typeof invitedEmail !=='undefined' ? invitedEmail : '' %>
                                </strong>
                            </p>

                            <p>
                                Registration Number:
                                <strong id="generatedRegisterNumber">
                                    <%= generatedRegisterNumber %>
                                </strong>
                            </p>

                            <button type="button" id="copyRegisterNumber" class="btn btn-outline-success btn-sm"
                                data-register-number="<%= generatedRegisterNumber %>">

                                <i class="bi bi-clipboard me-1"></i>
                                Copy Registration Number
                            </button>

                            <div id="copyMessage" class="small mt-2" aria-live="polite"></div>

                        </div>

                        <% } %>

                </section>
            </div>


            <!-- FINALIZE ANNUAL RESULTS -->
            <div class="col-12">
                <section class="section-card">

                    <h2 class="section-heading">
                        <span class="heading-icon">
                            <i class="bi bi-award-fill"></i>
                        </span>
                        Finalize Annual Results
                    </h2>

                    <p class="section-description">
                        Verify the annual marks before finalizing results.
                        This action may also promote students according to your server-side rules.
                    </p>

                    <form action="/teacher/annual-results/finalize" method="POST"
                        onsubmit="return confirm('Are you sure you want to finalize these annual results? Please verify all marks before continuing.');">

                        <div class="row align-items-end g-3">

                            <div class="col-12 col-md-6">
                                <label for="finalAcademicYear" class="form-label">
                                    Academic Year
                                </label>

                                <input type="text" id="finalAcademicYear" name="academic_year" class="form-control"
                                    placeholder="2026-2027" pattern="[0-9]{4}-[0-9]{4}"
                                    title="Enter the academic year in YYYY-YYYY format." required>
                            </div>

                            <div class="col-12 col-md-6">
                                <button type="submit" class="btn btn-success w-100 py-2">
                                    <i class="bi bi-check2-circle me-2"></i>
                                    Finalize Results &amp; Promote Students
                                </button>
                            </div>

                        </div>

                    </form>

                    <div class="small text-muted mt-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Make sure all annual marks are correct before completing this action.
                    </div>

                </section>
            </div>

        </div>


        <!-- EXAM MANAGEMENT -->
        <section class="content-section">

            <div class="section-top">
                <div>
                    <h2>
                        <i class="bi bi-journal-text section-title-icon"></i>
                        Exam Management
                    </h2>

                    <p>View, finalize and manage examinations created for your class.</p>
                </div>
            </div>

            <div class="row g-3">

                <% if (typeof exams !=='undefined' && exams.length> 0) { %>

                    <% exams.forEach(function(exam) { %>

                        <div class="col-12 col-md-6 col-xl-4">

                            <article class="exam-card">

                                <div class="exam-card-top">

                                    <div class="exam-icon">
                                        <i class="bi bi-journal-check"></i>
                                    </div>

                                    <% if (exam.status==='Finalized' ) { %>
                                        <span class="badge bg-success">Finalized</span>
                                        <% } else { %>
                                            <span class="badge bg-primary">Open</span>
                                            <% } %>

                                </div>

                                <h3>
                                    <%= exam.exam_name %>
                                </h3>

                                <div class="exam-detail">
                                    <i class="bi bi-calendar3"></i>
                                    <span>
                                        Academic Year: <strong>
                                            <%= exam.academic_year %>
                                        </strong>
                                    </span>
                                </div>

                                <div class="exam-detail">
                                    <i class="bi bi-mortarboard"></i>
                                    <span>
                                        Class: <strong>
                                            <%= exam.class %>
                                        </strong>
                                    </span>
                                </div>

                                <div class="exam-detail">
                                    <i class="bi bi-award"></i>
                                    <span>
                                        Total Marks: <strong>
                                            <%= exam.total_marks %>
                                        </strong>
                                    </span>
                                </div>

                                <% if (exam.exam_date) { %>
                                    <div class="exam-detail">
                                        <i class="bi bi-calendar-event"></i>
                                        <span>
                                            Exam Date:
                                            <strong>
                                                <%= new Date(exam.exam_date).toLocaleDateString('en-IN') %>
                                            </strong>
                                        </span>
                                    </div>
                                    <% } %>

                                        <div class="exam-detail">
                                            <i class="bi bi-person"></i>
                                            <span>
                                                Created By:
                                                <strong>
                                                    <%= exam.teacher_name || exam.created_by %>
                                                </strong>
                                            </span>
                                        </div>

                                        <div class="exam-actions">

                                            <% if (exam.status==='Open' ) { %>

                                                <form action="/teacher/exams/<%= exam.id %>/finalize" method="POST"
                                                    onsubmit="return confirm('Finalize this exam? Marks will become uneditable.');">

                                                    <button type="submit" class="btn btn-success w-100">
                                                        <i class="bi bi-lock-fill me-2"></i>
                                                        Finalize Exam
                                                    </button>

                                                </form>

                                                <% } else { %>

                                                    <button class="btn btn-secondary w-100" disabled>
                                                        <i class="bi bi-lock-fill me-2"></i>
                                                        Exam Locked
                                                    </button>

                                                    <% } %>


                                                        <% if ( exam.status==='Open' && typeof teacher !=='undefined' &&
                                                            String(exam.created_by)===String(teacher.teacher_id) ) { %>

                                                            <form action="/teacher/exams/<%= exam.id %>/delete"
                                                                method="POST"
                                                                onsubmit="return confirm('Are you sure you want to delete this exam? This action cannot be undone.');">

                                                                <button type="submit"
                                                                    class="btn btn-outline-danger w-100">
                                                                    <i class="bi bi-trash3 me-2"></i>
                                                                    Delete Exam
                                                                </button>

                                                            </form>

                                                            <% } %>

                                        </div>

                            </article>

                        </div>

                        <% }); %>

                            <% } else { %>

                                <div class="col-12">
                                    <div class="empty-state">
                                        <i class="bi bi-journal-x"></i>
                                        <h4>No Examinations Created</h4>
                                        <p class="mb-0">
                                            Create your first examination using the form above.
                                        </p>
                                    </div>
                                </div>

                                <% } %>

            </div>

        </section>


        <!-- STUDENT MANAGEMENT -->
        <section class="content-section">

            <div class="section-top">

                <div>
                    <h2>
                        <i class="bi bi-people-fill section-title-icon"></i>
                        My Students
                    </h2>

                    <p>Manage student profiles, class assignments and examination marks.</p>

                    <span class="student-count">
                        <i class="bi bi-people"></i>
                        <%= typeof students !=='undefined' ? students.length : 0 %>
                            Students
                    </span>
                </div>

                <div class="search-box">
                    <i class="bi bi-search"></i>

                    <input type="search" id="studentSearch" class="form-control"
                        placeholder="Search name or register number..." aria-label="Search students">
                </div>

            </div>


            <div class="row g-4" id="studentList">

                <% if (typeof students !=='undefined' && students.length> 0) { %>

                    <% students.forEach(function(student) { %>

                        <div class="col-12 col-sm-6 col-xl-4 student-item"
                            data-search="<%= ((student.name || '') + ' ' + (student.register_number || '')).toLowerCase() %>">

                            <article class="student-card">

                                <!-- STUDENT PROFILE -->
                                <div class="student-card-header">

                                    <div class="student-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </div>

                                    <span class="badge bg-success-subtle text-success">
                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        Active Student
                                    </span>

                                </div>

                                <div class="student-info">

                                    <h3>
                                        <%= student.name || 'Unnamed Student' %>
                                    </h3>

                                    <p class="register-number">
                                        <i class="bi bi-person-vcard me-1"></i>
                                        <%= student.register_number || 'No registration number' %>
                                    </p>

                                    <span class="student-class">
                                        <i class="bi bi-mortarboard-fill"></i>
                                        Class <%= student.class || 'Not assigned' %>
                                    </span>

                                </div>

                                <div class="student-divider"></div>


                                <!-- CLASS MANAGEMENT -->
                                <div class="student-tools">

                                    <p class="student-tools-title">
                                        <i class="bi bi-arrow-up-down"></i>
                                        Class Management
                                    </p>

                                    <div class="student-actions">

                                        <form
                                            action="/teacher/student/<%= encodeURIComponent(student.register_number) %>/class-change"
                                            method="POST"
                                            onsubmit="return confirm('Promote this student to the next class?');">

                                            <input type="hidden" name="direction" value="up">

                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="bi bi-arrow-up-circle me-1"></i>
                                                Promote
                                            </button>

                                        </form>

                                        <form
                                            action="/teacher/student/<%= encodeURIComponent(student.register_number) %>/class-change"
                                            method="POST"
                                            onsubmit="return confirm('Move this student to the previous class?');">

                                            <input type="hidden" name="direction" value="down">

                                            <button type="submit" class="btn btn-outline-warning btn-sm">
                                                <i class="bi bi-arrow-down-circle me-1"></i>
                                                Move Back
                                            </button>

                                        </form>

                                    </div>

                                </div>


                                <!-- EXAM MARKS ENTRY -->
                                <% if (typeof exams !=='undefined' && exams.length> 0) { %>

                                    <div class="student-divider mb-3"></div>

                                    <div class="px-3">

                                        <p class="student-tools-title">
                                            <i class="bi bi-journal-check"></i>
                                            Examination Marks
                                        </p>

                                    </div>

                                    <% exams.forEach(function(exam) { %>

                                        <form
                                            action="/teacher/exams/<%= exam.id %>/student/<%= encodeURIComponent(student.register_number) %>/marks"
                                            method="POST" class="marks-form">

                                            <h5>
                                                <i class="bi bi-journal-text me-1"></i>
                                                <%= exam.exam_name %>
                                            </h5>

                                            <p class="text-muted mb-3">
                                                Academic Year: <%= exam.academic_year %>
                                                    <span class="mx-1">·</span>
                                                    Total: <%= exam.total_marks %>
                                            </p>

                                            <% if (exam.status==='Open' ) { %>

                                                <label class="form-label">Marks Obtained</label>

                                                <input type="number" name="marks_obtained" class="form-control" min="0"
                                                    max="<%= exam.total_marks %>" step="0.01" placeholder="Enter marks"
                                                    required>

                                                <button type="submit" class="btn btn-primary btn-sm w-100">
                                                    <i class="bi bi-save me-1"></i>
                                                    Save / Update Marks
                                                </button>

                                                <% } else { %>

                                                    <div class="alert alert-success py-2 mb-0 small">
                                                        <i class="bi bi-lock-fill me-1"></i>
                                                        This examination is finalized.
                                                    </div>

                                                    <% } %>

                                        </form>

                                        <% }); %>

                                            <% } %>


                                                <!-- STUDENT ACTIONS -->
                                                <div class="student-divider"></div>

                                                <div class="student-tools">

                                                    <p class="student-tools-title">
                                                        <i class="bi bi-gear-fill"></i>
                                                        Student Actions
                                                    </p>

                                                    <div class="student-actions">

                                                        <a class="btn btn-outline-primary btn-sm"
                                                            href="/teacher/student/<%= encodeURIComponent(student.register_number) %>/edit">

                                                            <i class="bi bi-pencil-square me-1"></i>
                                                            Edit Profile

                                                        </a>

                                                        <form
                                                            action="/teacher/student/<%= encodeURIComponent(student.register_number) %>/delete"
                                                            method="POST"
                                                            onsubmit="return confirm('Are you sure you want to delete this student? This action cannot be undone.');">

                                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                                <i class="bi bi-trash me-1"></i>
                                                                Delete
                                                            </button>

                                                        </form>

                                                    </div>

                                                </div>

                                                <a class="view-profile"
                                                    href="/teacher/student/<%= encodeURIComponent(student.register_number) %>">

                                                    <i class="bi bi-eye-fill"></i>
                                                    View Student Details
                                                    <i class="bi bi-arrow-right ms-1"></i>


                                                </a>

                            </article>

                        </div>

                        <% }); %>

                            <% } else { %>

                                <div class="col-12">
                                    <div class="empty-state">
                                        <i class="bi bi-people"></i>
                                        <h4>No Students Found</h4>
                                        <p class="mb-0">
                                            There are currently no students in your assigned class.
                                        </p>
                                    </div>
                                </div>

                                <% } %>


                                    <!-- SEARCH EMPTY STATE -->
                                    <div class="col-12 d-none" id="noSearchResults">
                                        <div class="empty-state">
                                            <i class="bi bi-search"></i>
                                            <h4>No Matching Students</h4>
                                            <p class="mb-0">
                                                Try searching with a different name or registration number.
                                            </p>
                                        </div>
                                    </div>

            </div>

        </section>


        <footer class="footer-text">
            © <%= new Date().getFullYear() %> EduManage.
                Student Management System.
        </footer>

    </main>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Search students by name or registration number.
        const studentSearch = document.getElementById("studentSearch");
        const studentItems = document.querySelectorAll(".student-item");
        const noSearchResults = document.getElementById("noSearchResults");

        if (studentSearch) {
            studentSearch.addEventListener("input", function () {

                const query = this.value.trim().toLowerCase();
                let visibleCount = 0;

                studentItems.forEach(function (item) {

                    const searchableText = item.dataset.search || "";
                    const matches = searchableText.includes(query);

                    item.classList.toggle("d-none", !matches);

                    if (matches) {
                        visibleCount++;
                    }
                });

                if (noSearchResults) {
                    noSearchResults.classList.toggle(
                        "d-none",
                        query.length === 0 || visibleCount > 0
                    );
                }
            });
        }


        // Copy generated registration number.
        const copyButton = document.getElementById("copyRegisterNumber");
        const copyMessage = document.getElementById("copyMessage");

        if (copyButton) {

            copyButton.addEventListener("click", async function () {

                const registerNumber = this.dataset.registerNumber;

                try {

                    await navigator.clipboard.writeText(registerNumber);

                    copyMessage.textContent = "Registration number copied successfully!";

                } catch (error) {

                    copyMessage.textContent =
                        "Copy unavailable. Please copy the registration number manually.";

                }
            });
        }


        // Validate marks before submitting.
        document.querySelectorAll(".marks-form").forEach(function (form) {

            form.addEventListener("submit", function (event) {

                const marksInput = form.querySelector('input[name="marks_obtained"]');

                // Finalized exam forms do not have a marks input.
                if (!marksInput) {
                    return;
                }

                const obtained = Number(marksInput.value);
                const total = Number(marksInput.max);

                if (
                    !Number.isFinite(obtained) ||
                    obtained < 0 ||
                    obtained > total
                ) {

                    event.preventDefault();

                    alert("Marks obtained must be between 0 and the total marks.");
                }
            });
        });
    </script>

</body>

</html>