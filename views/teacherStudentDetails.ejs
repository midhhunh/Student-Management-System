
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Details | EduManage</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            margin: 0;
            background: #f4f6fb;
            font-family: 'Inter', sans-serif;
            color: #1e293b;
        }

        .navbar {
            background: linear-gradient(110deg, #172554, #312e81, #4f46e5);
            padding: 15px 0;
        }

        .navbar-brand {
            color: white;
            font-size: 21px;
            font-weight: 800;
        }

        .main-container {
            max-width: 900px;
            margin: 45px auto;
            padding: 0 18px;
        }

        .page-heading {
            margin-bottom: 25px;
        }

        .page-heading h1 {
            font-size: 27px;
            font-weight: 800;
            margin-bottom: 7px;
        }

        .page-heading p {
            color: #64748b;
            font-size: 13px;
        }

        .details-card {
            background: white;
            border: 1px solid #e5eaf2;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(15, 23, 42, .05);
        }

        .profile-header {
            padding: 30px;
            display: flex;
            align-items: center;
            gap: 20px;
            color: white;
            background: linear-gradient(115deg, #1e1b4b, #4338ca, #6366f1);
        }

        .avatar {
            width: 75px;
            height: 75px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            border-radius: 20px;
            background: rgba(255,255,255,.16);
            border: 1px solid rgba(255,255,255,.25);
            font-size: 35px;
        }

        .profile-header h2 {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 7px;
        }

        .profile-header p {
            font-size: 13px;
            color: #e0e7ff;
            margin: 0;
        }

        .details-content {
            padding: 30px;
        }

        .details-title {
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 22px;
        }

        .detail-item {
            padding: 16px;
            height: 100%;
            background: #f8fafc;
            border: 1px solid #edf0f5;
            border-radius: 11px;
        }

        .detail-item label {
            display: block;
            color: #64748b;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .detail-item p {
            margin: 0;
            color: #1e293b;
            font-size: 13px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .class-badge {
            display: inline-block;
            padding: 7px 12px;
            border-radius: 7px;
            color: #4338ca;
            background: #eef2ff;
        }

        .footer-actions {
            padding: 20px 30px;
            border-top: 1px solid #e5eaf2;
            display: flex;
            justify-content: space-between;
            gap: 12px;
        }

        .btn-back {
            background: #eef2ff;
            color: #4338ca;
            border: none;
            border-radius: 9px;
            padding: 10px 17px;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
        }

        .btn-back:hover {
            background: #4338ca;
            color: white;
        }

        @media(max-width: 576px) {
            .main-container {
                margin: 25px auto;
            }

            .profile-header {
                padding: 22px 18px;
                gap: 13px;
            }

            .avatar {
                width: 58px;
                height: 58px;
                font-size: 27px;
            }

            .profile-header h2 {
                font-size: 17px;
            }

            .details-content {
                padding: 20px 16px;
            }

            .footer-actions {
                padding: 17px;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/teacher/index">
                <i class="bi bi-mortarboard-fill me-2"></i>
                EduManage
            </a>
        </div>
    </nav>

    <main class="main-container">

        <div class="page-heading">
            <h1>Student Details</h1>
            <p>View the personal and academic information of your student.</p>
        </div>

        <section class="details-card">

            <div class="profile-header">

                <div class="avatar">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>
                    <h2><%= student.name %></h2>
                    <p>
                        <i class="bi bi-person-vcard me-1"></i>
                        Register Number: <%= student.register_number %>
                    </p>
                </div>

            </div>

            <div class="details-content">

                <h3 class="details-title">
                    <i class="bi bi-info-circle-fill text-primary me-2"></i>
                    Personal Information
                </h3>

                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <div class="detail-item">
                            <label>Student ID</label>
                            <p><%= student.id %></p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="detail-item">
                            <label>Full Name</label>
                            <p><%= student.name || '—' %></p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="detail-item">
                            <label>Registration Number</label>
                            <p><%= student.register_number || '—' %></p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="detail-item">
                            <label>Email Address</label>
                            <p><%= student.email || '—' %></p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="detail-item">
                            <label>Mobile Number</label>
                            <p><%= student.mobile || '—' %></p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="detail-item">
                            <label>Class</label>
                            <p>
                                <span class="class-badge">
                                    <%= student.class ? 'Class ' + student.class : 'Not Assigned' %>
                                </span>
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="detail-item">
                            <label>Aadhaar Number</label>
                            <p><%= student.aadhaar || '—' %></p>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="detail-item">
                            <label>Address</label>
                            <p><%= student.address || '—' %></p>
                        </div>
                    </div>

                </div>

                <!-- Exam Marks -->
<div class="card border-0 shadow-sm mt-4">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-journal-check me-2 text-primary"></i>
            Exam Marks
        </h5>
    </div>

    <div class="card-body">
        <% if (typeof examMarks !== 'undefined' && examMarks.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Exam Name</th>
                            <th>Academic Year</th>
                            <th>Marks Scored</th>
                            <th>Total Marks</th>
                            <th>Percentage</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% examMarks.forEach(mark => { %>
                            <tr>
                                <td><%= mark.exam_name %></td>
                                <td><%= mark.academic_year %></td>
                                <td class="fw-bold text-primary">
                                    <%= mark.marks_obtained %>
                                </td>
                                <td><%= mark.total_marks %></td>
                                <td><%= Number(mark.percentage).toFixed(2) %>%</td>
                                <td>
                                    <% if (mark.status === 'Pass') { %>
                                        <span class="badge bg-success">Pass</span>
                                    <% } else { %>
                                        <span class="badge bg-danger">Fail</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-muted text-center mb-0">
                No finalized exam marks available for this student.
            </p>
        <% } %>
    </div>
</div>

            </div>

            <div class="footer-actions">

                <a href="/teacher/index" class="btn-back">
                    <i class="bi bi-arrow-left me-2"></i>
                    Back to Students
                </a>

            </div>

        </section>

    </main>

</body>
</html>
