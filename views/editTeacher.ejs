<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Teacher</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <div class="container mt-5">
        <div class="card shadow mx-auto" style="max-width: 600px;">
            <div class="card-header bg-primary text-white">
                <h3>Edit Teacher Details</h3>
            </div>

            <div class="card-body">
                <form action="/admin/teacher/<%= encodeURIComponent(teacher.teacher_id) %>/edit" method="POST">

                    <div class="mb-3">
                        <label class="form-label">Teacher ID</label>
                        <input type="text" class="form-control" value="<%= teacher.teacher_id %>" readonly>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="form-control" value="<%= teacher.name %>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" value="<%= teacher.email %>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mobile</label>
                        <input type="text" name="mobile" class="form-control" value="<%= teacher.mobile %>" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Class Responsibility</label>
                        <select name="class" class="form-select">
                            <option value="" <%=!teacher.class ? "selected" : "" %>>
                                No class assigned
                            </option>

                            <% for (let i=1; i <=12; i++) { %>
                                <option value="<%= i %>" <%=String(teacher.class || "" ).trim()===String(i) ? "selected"
                                    : "" %>>
                                    Class <%= i %>
                                </option>
                                <% } %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <textarea name="address" class="form-control" required><%= teacher.address %></textarea>
                    </div>

                    <button type="submit" class="btn btn-success">
                        Save Changes
                    </button>

                    <a href="/admin/home" class="btn btn-secondary">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    </div>

</body>

</html>