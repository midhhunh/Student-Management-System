
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduManage | Student Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="/css/home.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <span class="brand-icon">E</span>
                EduManage<span class="brand-dot">.</span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link active" href="#home">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Features</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>
                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <a class="nav-login" href="/students/login">
                            Login <span>→</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section" id="home">
        <div class="hero-glow glow-one"></div>
        <div class="hero-glow glow-two"></div>

        <div class="container">
            <div class="row align-items-center hero-content">

                <div class="col-lg-7 hero-text">
                    <div class="welcome-badge">
                        <span class="status-dot"></span>
                        YOUR SMART CAMPUS EXPERIENCE
                    </div>

                    <h1>
                        Welcome to <br>
                        <span class="gradient-text">EduManage</span>
                    </h1>

                    <p class="hero-description">
                        A smarter way to manage education. Access student
                        records, connect teachers, and track academic progress
                        — all in one place.
                    </p>

                    <div class="hero-buttons">
                        <a href="/students/login" class="btn-primary-custom">
                            Get Started <span>→</span>
                        </a>

                        <a href="#features" class="btn-secondary-custom">
                            Explore Features
                        </a>
                    </div>

                    <div class="hero-note">
                        <span class="check-icon">✓</span>
                        Simple · Secure · Efficient
                    </div>
                </div>

                <!-- Decorative dashboard preview -->
                <div class="col-lg-5 hero-visual">
                    <div class="dashboard-card">

                        <div class="dashboard-top">
                            <div>
                                <span class="mini-label">EDUMANAGE OVERVIEW</span>
                                <h5>Welcome back! 👋</h5>
                            </div>
                            <div class="dashboard-avatar">E</div>
                        </div>

                        <div class="dashboard-banner">
                            <div>
                                <span>YOUR FUTURE STARTS HERE</span>
                                <h4>Learn. Grow.<br>Achieve.</h4>
                            </div>
                            <div class="banner-symbol">✦</div>
                        </div>

                        <div class="dashboard-stats">
                            <div class="stat-card">
                                <div class="stat-icon students-icon">♧</div>
                                <span>Students</span>
                                <strong>Records</strong>
                                <small>Easy access</small>
                            </div>

                            <div class="stat-card">
                                <div class="stat-icon results-icon">↗</div>
                                <span>Academic</span>
                                <strong>Results</strong>
                                <small>Track progress</small>
                            </div>
                        </div>

                        <div class="dashboard-footer">
                            <span class="footer-check">✓</span>
                            Everything in one place
                            <span class="footer-sparkle">✦</span>
                        </div>
                    </div>

                    <div class="floating-chip chip-top">
                        <span>✦</span> Smart Learning
                    </div>

                    <div class="floating-chip chip-bottom">
                        <span>✓</span> Stay Organized
                    </div>
                </div>

            </div>
        </div>

        <div class="hero-bottom-line"></div>
    </section>

    <!-- Features Section -->
    <section class="features-section" id="features">
        <div class="container">

            <div class="section-heading text-center">
                <span class="section-label">WHAT WE OFFER</span>
                <h2>Everything you need, <span>in one place.</span></h2>
                <p>
                    Powerful tools designed to make school management
                    easier for everyone.
                </p>
            </div>

            <div class="row g-4 mt-4">

                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon icon-blue">♙</div>
                        <h5>Student Records</h5>
                        <p>
                            View and manage student profiles, personal
                            information, and class details.
                        </p>
                        <a href="/students/login">Explore <span>→</span></a>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon icon-purple">♧</div>
                        <h5>Teacher Management</h5>
                        <p>
                            Organize teacher information, assigned classes,
                            and classroom responsibilities.
                        </p>
                        <a href="/students/login">Explore <span>→</span></a>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon icon-green">▤</div>
                        <h5>Academic Results</h5>
                        <p>
                            Record marks, review academic performance,
                            and follow student progress.
                        </p>
                        <a href="/students/login">Explore <span>→</span></a>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="feature-icon icon-orange">♢</div>
                        <h5>Secure Access</h5>
                        <p>
                            Dedicated login access for students, teachers,
                            and administrators.
                        </p>
                        <a href="/students/login">Explore <span>→</span></a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- About / Call to Action -->
    <section class="cta-section" id="about">
        <div class="container">
            <div class="cta-card">
                <div class="cta-decoration">✦</div>

                <span class="section-label">READY TO BEGIN?</span>
                <h2>Your campus. Your progress. <span>One platform.</span></h2>
                <p>
                    Sign in to access your personalized EduManage dashboard.
                </p>

                <a href="/students/login" class="btn-primary-custom">
                    Enter EduManage <span>→</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container footer-content">
            <a class="navbar-brand footer-brand" href="#home">
                <span class="brand-icon">E</span>
                EduManage<span class="brand-dot">.</span>
            </a>

            <p>Making education management smarter and simpler.</p>

            <span class="copyright">
                © <span id="currentYear"></span> EduManage. All rights reserved.
            </span>
        </div>
    </footer>

    <script>
        document.getElementById("currentYear").textContent =
            new Date().getFullYear();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>