
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Student | EduManage</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            padding: 35px 15px;
            font-family: "Segoe UI", Arial, sans-serif;
            background: linear-gradient(135deg, #eef2ff, #f8fafc, #e0f2fe);
            color: #1e293b;
        }

        .edit-container {
            max-width: 700px;
            margin: 0 auto;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 18px;
            color: #475569;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: #2563eb;
        }

        .edit-card {
            overflow: hidden;
            border: 0;
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 15px 45px rgba(15, 23, 42, 0.12);
        }

        .edit-header {
            padding: 28px;
            color: white;
            background: linear-gradient(120deg, #1d4ed8, #6366f1);
        }

        .header-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 52px;
            height: 52px;
            margin-bottom: 15px;
            border-radius: 15px;
            background: rgba(255, 255, 255, 0.18);
            font-size: 25px;
        }

        .edit-header h1 {
            margin: 0 0 8px;
            font-size: clamp(23px, 4vw, 30px);
            font-weight: 700;
        }

        .edit-header p {
            margin: 0;
            color: #e0e7ff;
        }

        .edit-body {
            padding: 30px;
        }

        .form-label {
            margin-bottom: 8px;
            color: #334155;
            font-weight: 600;
        }

        .form-control,
        .form-select {
            min-height: 47px;
            border: 1px solid #dbe3ef;
            border-radius: 10px;
            background-color: #f8fafc;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #6366f1;
            background-color: #fff;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.13);
        }

        textarea.form-control {
            min-height: 105px;
            resize: vertical;
        }

        .form-control[readonly] {
            color: #64748b;
            background: #f1f5f9;
        }

        .form-text {
            color: #64748b;
        }

        .form-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 28px;
            padding-top: 22px;
            border-top: 1px solid #e2e8f0;
        }

        .btn {
            min-height: 45px;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 600;
        }

        .btn-save {
            color: white;
            border: none;
            background: linear-gradient(120deg, #2563eb, #4f46e5);
        }

        .btn-save:hover {
            color: white;
            background: linear-gradient(120deg, #1d4ed8, #4338ca);
            transform: translateY(-1px);
        }

        .btn-cancel {
            color: #334155;
            border: 1px solid #cbd5e1;
            background: #fff;
        }

        .btn-cancel:hover {
            background: #f1f5f9;
        }

        @media (max-width: 576px) {
            body {
                padding: 20px 12px;
            }

            .edit-header,
            .edit-body {
                padding: 22px 18px;
            }

            .form-actions {
                flex-direction: column;
            }

            .form-actions .btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <main class="edit-container">

        <a href="/admin/home" class="back-link">
            <i class="bi bi-arrow-left"></i>
            Back to Admin Dashboard
        </a>

        <section class="edit-card">

            <header class="edit-header">
                <div class="header-icon">
                    <i class="bi bi-person-gear"></i>
                </div>

                <h1>Edit Student Details</h1>
                <p>Update the student's information below.</p>
            </header>

            <div class="edit-body">

                <form
                    action="/admin/student/<%= encodeURIComponent(student.register_number) %>/edit"
                    method="POST"
                    id="editStudentForm">

                    <div class="mb-4">
                        <label for="register_number" class="form-label">
                            Register Number
                        </label>

                        <input
                            type="text"
                            id="register_number"
                            class="form-control"
                            value="<%= student.register_number %>"
                            readonly>

                        <div class="form-text">
                            <i class="bi bi-lock"></i>
                            Register number cannot be changed.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="name" class="form-label">
                            Full Name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            class="form-control"
                            value="<%= student.name %>"
                            minlength="2"
                            maxlength="100"
                            required>
                    </div>

                    <div class="mb-4">
                        <label for="email" class="form-label">
                            Email Address
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            class="form-control"
                            value="<%= student.email %>"
                            maxlength="150"
                            required>
                    </div>

                    <div class="mb-4">
                        <label for="mobile" class="form-label">
                            Mobile Number
                        </label>

                        <input
                            type="tel"
                            id="mobile"
                            name="mobile"
                            class="form-control"
                            value="<%= student.mobile %>"
                            pattern="[0-9]{10}"
                            maxlength="10"
                            inputmode="numeric"
                            title="Enter a 10-digit mobile number"
                            required>

                        <div class="form-text">
                            Enter a 10-digit mobile number.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="class" class="form-label">
                            Class
                        </label>

                        <select
                            id="class"
                            name="class"
                            class="form-select"
                            required>

                            <% for (let i = 1; i <= 12; i++) { %>
                                <option
                                    value="<%= i %>"
                                    <%= String(student.class).trim() === String(i) ? "selected" : "" %>>
                                    Class <%= i %>
                                </option>
                            <% } %>

                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="address" class="form-label">
                            Address
                        </label>

                        <textarea
                            id="address"
                            name="address"
                            class="form-control"
                            maxlength="500"
                            required><%= student.address %></textarea>
                    </div>

                    <div class="form-actions">

                        <button type="submit" class="btn btn-save">
                            <i class="bi bi-check-circle me-2"></i>
                            Save Changes
                        </button>

                        <a href="/admin/home" class="btn btn-cancel">
                            <i class="bi bi-x-circle me-2"></i>
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </section>

        <p class="text-center text-secondary small mt-4">
            <i class="bi bi-shield-check me-1"></i>
            EduManage Student Management System
        </p>

    </main>

    <script>
        document.getElementById("editStudentForm").addEventListener("submit", function (event) {
            const mobile = document.getElementById("mobile").value.trim();

            if (!/^[0-9]{10}$/.test(mobile)) {
                event.preventDefault();
                alert("Please enter a valid 10-digit mobile number.");
                return;
            }
        });
    </script>

</body>
</html>
