<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration | EduManage</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link href="/css/register.css" rel="stylesheet">

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        defer>
    </script>
</head>

<body>
    <div class="register-wrapper">

        <% if (typeof error !== "undefined" && error) { %>
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">
                <%= error %>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        <% } %>

        <% if (typeof success !== "undefined" && success) { %>
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">
                <%= success %>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        <% } %>

        <!-- Registration tabs -->
        <div class="form-tabs">
            <button type="button"
                    class="switch-btn active"
                    id="student-tab"
                    onclick="showForm('student')">
                Student Register
            </button>

            <button type="button"
                    class="switch-btn"
                    id="teacher-tab"
                    onclick="showForm('teacher')">
                Teacher Register
            </button>
        </div>

        <!-- Student registration -->
        <div class="reg" id="student-form">
            <h1 class="reg_head">Student Register</h1>

            <form method="POST"
                  class="reg_form"
                  action="/students/register">

                <label for="student-fullname">Full Name</label>
                <input type="text"
                       id="student-fullname"
                       name="fullname"
                       placeholder="Enter full name"
                       autocomplete="name"
                       required>

                <label for="reg_no">Registration Number</label>
                <input type="text"
                       id="reg_no"
                       name="registerNumber"
                       placeholder="Enter the number issued by your teacher"
                       autocomplete="off"
                       required>

                <label for="student-email">Email</label>
                <input type="email"
                       id="student-email"
                       name="email"
                       placeholder="Enter email"
                       autocomplete="email"
                       required>

                <label for="student-pass">Password</label>
                <input type="password"
                       id="student-pass"
                       name="password"
                       class="password"
                       placeholder="Create a password (minimum 8 characters)"
                       minlength="8"
                       autocomplete="new-password"
                       required>

                <label for="student-mob">Mobile</label>
                <input type="tel"
                       id="student-mob"
                       name="mob"
                       placeholder="Enter 10-digit mobile number"
                       inputmode="numeric"
                       pattern="[0-9]{10}"
                       maxlength="10"
                       required>

                <label for="student-aadhar">Aadhaar Number</label>
                <input type="text"
                       id="student-aadhar"
                       name="aadhar"
                       placeholder="Enter 12-digit Aadhaar number"
                       inputmode="numeric"
                       pattern="[0-9]{12}"
                       maxlength="12"
                       required>

                <label for="student-address">Address</label>
                <textarea id="student-address"
                          name="address"
                          placeholder="Enter your address"
                          rows="3"
                          required></textarea>

                <button type="submit" class="submit">
                    Register Student
                </button>
            </form>
        </div>

        <!-- Teacher registration -->
        <div class="reg" id="teacher-form" hidden>
            <h1 class="reg_head">Teacher Register</h1>

            <form method="POST"
                  class="reg_form"
                  action="/teacher/register">

                <label for="teacher-fullname">Full Name</label>
                <input type="text"
                       id="teacher-fullname"
                       name="fullname"
                       placeholder="Enter full name"
                       autocomplete="name"
                       required>

                <label for="tid">Teacher ID</label>
                <input type="text"
                       id="tid"
                       name="tid"
                       placeholder="Enter the teacher ID issued to you"
                       autocomplete="off"
                       required>

                <label for="teacher-email">Email</label>
                <input type="email"
                       id="teacher-email"
                       name="email"
                       placeholder="Enter email"
                       autocomplete="email"
                       required>

                <label for="teacher-pass">Password</label>
                <input type="password"
                       id="teacher-pass"
                       name="password"
                       class="password"
                       placeholder="Create a password (minimum 8 characters)"
                       minlength="8"
                       autocomplete="new-password"
                       required>

                <label for="teacher-mob">Mobile</label>
                <input type="tel"
                       id="teacher-mob"
                       name="mob"
                       placeholder="Enter 10-digit mobile number"
                       inputmode="numeric"
                       pattern="[0-9]{10}"
                       maxlength="10"
                       required>

                <p class="text-muted">
                    The administrator will assign your class responsibility
                    after registration.
                </p>

                <label for="teacher-aadhar">Aadhaar Number</label>
                <input type="text"
                       id="teacher-aadhar"
                       name="aadhar"
                       placeholder="Enter 12-digit Aadhaar number"
                       inputmode="numeric"
                       pattern="[0-9]{12}"
                       maxlength="12"
                       required>

                <label for="teacher-address">Address</label>
                <textarea id="teacher-address"
                          name="address"
                          placeholder="Enter your address"
                          rows="3"
                          required></textarea>

                <button type="submit" class="submit">
                    Register Teacher
                </button>
            </form>
        </div>

        <p class="text-center mt-3 mb-0">
            Already registered?
            <a href="/students/login">Student Login</a>
            <span class="mx-1">|</span>
            <a href="/teacher/login">Teacher Login</a>
        </p>
    </div>

    <script>
        function showForm(type) {
            const studentForm = document.getElementById("student-form");
            const teacherForm = document.getElementById("teacher-form");
            const studentTab = document.getElementById("student-tab");
            const teacherTab = document.getElementById("teacher-tab");

            const isStudent = type === "student";

            studentForm.hidden = !isStudent;
            teacherForm.hidden = isStudent;

            studentTab.classList.toggle("active", isStudent);
            teacherTab.classList.toggle("active", !isStudent);
        }

        // Keep the correct registration tab selected after a server redirect.
        // The server should pass formType as "student" or "teacher".
        const formType =
            <%- JSON.stringify(
                typeof formType !== "undefined" ? formType : "student"
            ) %>;

        showForm(formType === "teacher" ? "teacher" : "student");
    </script>
</body>

</html>