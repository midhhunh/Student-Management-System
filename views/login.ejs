<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>
        <link href="/css/login.css" rel="stylesheet">
</head>

<body>

    <div class="login">
        <h1 class="login_head">EduManage</h1>
        <p class="subtitle">Welcome back! Please log in.</p>

        <!-- Role switch buttons -->
        <div class="role-switch">
            <button type="button" class="role-btn active"
                onclick="switchRole('student', this)">
                Student
            </button>

            <button type="button" class="role-btn"
                onclick="switchRole('teacher', this)">
                Teacher
            </button>

            <button type="button" class="role-btn"
                onclick="switchRole('admin', this)">
                Admin
            </button>
        </div>

        <h3 id="roleTitle">Student Login</h3>

        <!-- Login form -->
        <form method="POST" action="/students/login"
            class="login_form" id="loginForm">

            <input type="hidden" name="role" id="role" value="student">

            <label for="email" id="emailLabel">Student Email</label>
            <input type="email" class="form-control" id="email"
                name="email" placeholder="Enter your email" required>

            <br>

            <label for="password">Password</label>
            <input type="password" class="form-control" id="password"
                name="password" placeholder="Enter your password" required>

            <br>

            <button type="submit" class="submit">Login</button>

            <div class="footer" id="registerFooter">
                <span>Don't have an account?</span>
                <a href="/students/register">Register</a>
            </div>
        </form>
    </div>

    <script>
        function switchRole(selectedRole, button) {
            const form = document.getElementById("loginForm");
            const roleInput = document.getElementById("role");
            const title = document.getElementById("roleTitle");
            const emailLabel = document.getElementById("emailLabel");
            const emailInput = document.getElementById("email");
            const registerFooter = document.getElementById("registerFooter");

            // Save selected role
            roleInput.value = selectedRole;

            // Change form action and heading
            if (selectedRole === "student") {
                form.action = "/students/login";
                title.textContent = "Student Login";
                emailLabel.textContent = "Student Email";
                emailInput.placeholder = "Enter student email";
                registerFooter.style.display = "block";
            } 
            else if (selectedRole === "teacher") {
                form.action = "/teacher/login";
                title.textContent = "Teacher Login";
                emailLabel.textContent = "Teacher Email";
                emailInput.placeholder = "Enter teacher email";
                registerFooter.style.display = "block";
            } 
            else if (selectedRole === "admin") {
                form.action = "/admin/login";
                title.textContent = "Admin Login";
                emailLabel.textContent = "Admin Email";
                emailInput.placeholder = "Enter admin email";
                registerFooter.style.display = "none";
            }

            // Highlight selected button
            document.querySelectorAll(".role-btn").forEach(btn => {
                btn.classList.remove("active");
            });

            button.classList.add("active");
        }
    </script>

</body>


</html>