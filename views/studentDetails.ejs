
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Details | EduManage</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #3730a3;
            --navy: #172554;
            --text: #334155;
            --muted: #64748b;
            --border: #e2e8f0;
            --background: #f4f6fb;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--background);
            color: var(--text);
            min-height: 100vh;
        }

        /* NAVBAR */

        .navbar {
            background: #ffffff;
            padding: 15px 0;
            border-bottom: 1px solid var(--border);
            box-shadow: 0 3px 15px rgba(15, 23, 42, 0.04);
        }

        .navbar-brand {
            font-size: 23px;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: -1px;
        }

        .navbar-brand span {
            color: #7c3aed;
        }

        .back-btn {
            text-decoration: none;
            color: #475569;
            background: #f1f5f9;
            padding: 10px 17px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 600;
            transition: 0.3s;
        }

        .back-btn:hover {
            background: var(--primary);
            color: white;
        }

        /* MAIN CONTAINER */

        .main-container {
            max-width: 1150px;
            margin: 42px auto;
            padding: 0 20px;
        }

        .page-heading {
            margin-bottom: 25px;
        }

        .breadcrumb-text {
            font-size: 12px;
            color: var(--muted);
            margin-bottom: 9px;
        }

        .page-heading h2 {
            font-size: 27px;
            font-weight: 800;
            color: var(--navy);
            letter-spacing: -0.7px;
            margin-bottom: 7px;
        }

        .page-heading p {
            font-size: 13px;
            color: var(--muted);
            margin: 0;
        }

        /* PROFILE CARD */

        .profile-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(15, 23, 42, 0.05);
            margin-bottom: 25px;
        }

        .profile-header {
            position: relative;
            overflow: hidden;
            background: linear-gradient(115deg, #172554, #3730a3, #6366f1);
            padding: 35px;
            color: white;
            display: flex;
            align-items: center;
            gap: 23px;
        }

        .profile-header::after {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            border: 35px solid rgba(255,255,255,0.06);
            right: -65px;
            top: -110px;
        }

        .profile-icon {
            width: 85px;
            height: 85px;
            min-width: 85px;
            border-radius: 22px;
            background: rgba(255,255,255,0.16);
            border: 1px solid rgba(255,255,255,0.3);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 42px;
        }

        .profile-info {
            position: relative;
            z-index: 1;
        }

        .profile-info h3 {
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 9px;
        }

        .profile-info p {
            font-size: 13px;
            color: #e0e7ff;
            margin: 0;
        }

        .profile-tag {
            display: inline-block;
            margin-top: 12px;
            padding: 6px 12px;
            border-radius: 30px;
            background: rgba(255,255,255,0.15);
            color: white;
            font-size: 11px;
            font-weight: 600;
        }

        /* PERSONAL INFORMATION */

        .section-content {
            padding: 30px;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 22px;
        }

        .section-heading h5 {
            color: var(--navy);
            font-size: 16px;
            font-weight: 800;
            margin: 0;
        }

        .section-heading p {
            color: var(--muted);
            font-size: 12px;
            margin: 5px 0 0;
        }

        .section-heading i {
            color: var(--primary);
            margin-right: 8px;
        }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 15px;
        }

        .detail-box {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 18px;
            background: #f8fafc;
            border: 1px solid var(--border);
            border-radius: 12px;
            transition: 0.25s;
            min-width: 0;
        }

        .detail-box:hover {
            background: #f1f5ff;
            border-color: #c7d2fe;
            transform: translateY(-2px);
        }

        .detail-icon {
            width: 44px;
            height: 44px;
            min-width: 44px;
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #e0e7ff;
            color: var(--primary);
            font-size: 19px;
        }

        .detail-content {
            min-width: 0;
        }

        .detail-content label {
            display: block;
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 6px;
        }

        .detail-content p {
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin: 0;
            overflow-wrap: anywhere;
        }

        .address-box {
            grid-column: span 2;
        }

        /* RESULT CARDS */

        .result-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 25px;
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.045);
        }

        .result-header {
            padding: 21px 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            color: white;
        }

        .exam-header {
            background: linear-gradient(110deg, #3730a3, #6366f1);
        }

        .annual-header {
            background: linear-gradient(110deg, #172554, #334155);
        }

        .result-title {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .result-title-icon {
            width: 43px;
            height: 43px;
            border-radius: 12px;
            background: rgba(255,255,255,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .result-title h5 {
            font-size: 15px;
            font-weight: 800;
            margin: 0 0 4px;
        }

        .result-title p {
            font-size: 11px;
            color: rgba(255,255,255,0.8);
            margin: 0;
        }

        .result-count {
            padding: 7px 12px;
            border-radius: 30px;
            background: rgba(255,255,255,0.15);
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .result-body {
            padding: 25px;
        }

        /* TABLE */

        .table-responsive {
            border: 1px solid var(--border);
            border-radius: 11px;
        }

        .table {
            margin-bottom: 0;
            white-space: nowrap;
        }

        .table thead th {
            background: #f8fafc;
            color: #64748b;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 15px 14px;
            border-bottom: 1px solid var(--border);
        }

        .table tbody td {
            padding: 15px 14px;
            font-size: 12px;
            color: #475569;
            font-weight: 500;
            vertical-align: middle;
            border-color: #edf0f5;
        }

        .table tbody tr:hover {
            background: #f8faff;
        }

        .table tbody tr:last-child td {
            border-bottom: 0;
        }

        .marks-value {
            color: var(--navy);
            font-weight: 800;
        }

        .percentage-value {
            color: var(--primary);
            font-weight: 800;
        }

        .badge {
            font-size: 10px;
            font-weight: 700;
            padding: 7px 12px;
            border-radius: 30px;
        }

        .badge-pass {
            background: #dcfce7;
            color: #15803d;
        }

        .badge-fail {
            background: #fee2e2;
            color: #b91c1c;
        }

        .badge-finalized {
            background: #dcfce7;
            color: #15803d;
        }

        .badge-pending {
            background: #fef3c7;
            color: #92400e;
        }

        /* EMPTY STATE */

        .empty-state {
            text-align: center;
            padding: 35px 20px;
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            border-radius: 12px;
        }

        .empty-icon {
            width: 55px;
            height: 55px;
            border-radius: 16px;
            background: #e0e7ff;
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin: 0 auto 13px;
        }

        .empty-state h6 {
            color: var(--navy);
            font-weight: 700;
            font-size: 14px;
            margin-bottom: 6px;
        }

        .empty-state p {
            color: var(--muted);
            font-size: 12px;
            margin: 0;
        }

        /* FOOTER */

        .page-footer {
            background: white;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 19px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-top: 30px;
        }

        .footer-note {
            color: var(--muted);
            font-size: 11px;
        }

        .footer-note i {
            color: #16a34a;
            margin-right: 6px;
        }

        .footer-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            background: var(--primary);
            color: white;
            padding: 11px 19px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 700;
            transition: 0.3s;
            white-space: nowrap;
        }

        .footer-btn:hover {
            background: var(--primary-dark);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(79,70,229,0.2);
        }

        /* RESPONSIVE */

        @media(max-width: 768px) {
            .main-container {
                margin: 28px auto;
            }

            .section-content,
            .result-body {
                padding: 20px;
            }

            .profile-header {
                padding: 27px 22px;
            }

            .page-heading h2 {
                font-size: 23px;
            }
        }

        @media(max-width: 600px) {
            .navbar-brand {
                font-size: 20px;
            }

            .back-btn {
                font-size: 11px;
                padding: 9px 11px;
            }

            .profile-header {
                flex-direction: column;
                text-align: center;
            }

            .profile-info h3 {
                font-size: 20px;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

            .address-box {
                grid-column: span 1;
            }

            .section-heading {
                align-items: flex-start;
            }

            .result-header {
                align-items: flex-start;
                flex-direction: column;
            }

            .page-footer {
                flex-direction: column;
                text-align: center;
            }

            .main-container {
                padding: 0 13px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->

    <nav class="navbar">
        <div class="container d-flex justify-content-between align-items-center">

            <a class="navbar-brand text-decoration-none" href="/admin/index">
                Edu<span>Manage</span>
            </a>

            <a href="/admin/index" class="back-btn">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Admin
            </a>

        </div>
    </nav>


    <main class="main-container">

        <!-- PAGE HEADING -->

        <div class="page-heading">

            <div class="breadcrumb-text">
                <i class="bi bi-house-door me-1"></i>
                Admin / Students / Student Details
            </div>

            <h2>Student Profile</h2>

            <p>View personal information and academic performance.</p>

        </div>


        <!-- STUDENT PROFILE -->

        <section class="profile-card">

            <div class="profile-header">

                <div class="profile-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <div class="profile-info">

                    <h3><%= student.name %></h3>

                    <p>
                        <i class="bi bi-person-badge me-1"></i>
                        Register Number: <%= student.register_number %>
                    </p>

                    <span class="profile-tag">
                        <i class="bi bi-mortarboard me-1"></i>
                        Student Profile
                    </span>

                </div>

            </div>


            <!-- PERSONAL INFORMATION -->

            <div class="section-content">

                <div class="section-heading">

                    <div>
                        <h5>
                            <i class="bi bi-person-lines-fill"></i>
                            Personal Information
                        </h5>
                        <p>Student's registered personal details</p>
                    </div>

                    <i class="bi bi-shield-check fs-4"></i>

                </div>


                <div class="details-grid">

                    <div class="detail-box">
                        <div class="detail-icon">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="detail-content">
                            <label>Full Name</label>
                            <p><%= student.name || 'Not available' %></p>
                        </div>
                    </div>


                    <div class="detail-box">
                        <div class="detail-icon">
                            <i class="bi bi-card-heading"></i>
                        </div>
                        <div class="detail-content">
                            <label>Register Number</label>
                            <p><%= student.register_number || 'Not available' %></p>
                        </div>
                    </div>


                    <div class="detail-box">
                        <div class="detail-icon">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div class="detail-content">
                            <label>Email Address</label>
                            <p><%= student.email || 'Not available' %></p>
                        </div>
                    </div>


                    <div class="detail-box">
                        <div class="detail-icon">
                            <i class="bi bi-telephone"></i>
                        </div>
                        <div class="detail-content">
                            <label>Mobile Number</label>
                            <p><%= student.mobile || 'Not available' %></p>
                        </div>
                    </div>


                    <div class="detail-box">
                        <div class="detail-icon">
                            <i class="bi bi-mortarboard"></i>
                        </div>
                        <div class="detail-content">
                            <label>Current Class</label>
                            <p>
                                <%= student.class ? 'Class ' + student.class : 'Not assigned' %>
                            </p>
                        </div>
                    </div>


                    <div class="detail-box address-box">
                        <div class="detail-icon">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div class="detail-content">
                            <label>Residential Address</label>
                            <p><%= student.address || 'Not available' %></p>
                        </div>
                    </div>

                </div>

            </div>

        </section>


        <!-- EXAMINATION RESULTS -->

        <section class="result-card">

            <div class="result-header exam-header">

                <div class="result-title">

                    <div class="result-title-icon">
                        <i class="bi bi-journal-check"></i>
                    </div>

                    <div>
                        <h5>Examination Results</h5>
                        <p>Individual examination performance</p>
                    </div>

                </div>

                <span class="result-count">
                    <%= examMarks ? examMarks.length : 0 %> Exams
                </span>

            </div>


            <div class="result-body">

                <% if (examMarks && examMarks.length > 0) { %>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Exam Name</th>
                                    <th>Academic Year</th>
                                    <th>Exam Date</th>
                                    <th>Marks Obtained</th>
                                    <th>Total Marks</th>
                                    <th>Percentage</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% examMarks.forEach(mark => { %>

                                    <tr>

                                        <td>
                                            <strong><%= mark.exam_name %></strong>
                                        </td>

                                        <td><%= mark.academic_year %></td>

                                        <td>
                                            <%= mark.exam_date
                                                ? new Date(mark.exam_date).toLocaleDateString('en-IN')
                                                : 'Not specified' %>
                                        </td>

                                        <td>
                                            <span class="marks-value">
                                                <%= mark.marks_obtained %>
                                            </span>
                                        </td>

                                        <td><%= mark.total_marks %></td>

                                        <td>
                                            <span class="percentage-value">
                                                <%= mark.percentage %>%
                                            </span>
                                        </td>

                                        <td>
                                            <% if (mark.status === 'Pass') { %>
                                                <span class="badge badge-pass">
                                                    <i class="bi bi-check-circle me-1"></i>Pass
                                                </span>
                                            <% } else { %>
                                                <span class="badge badge-fail">
                                                    <i class="bi bi-x-circle me-1"></i>Fail
                                                </span>
                                            <% } %>
                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                <% } else { %>

                    <div class="empty-state">

                        <div class="empty-icon">
                            <i class="bi bi-journal-x"></i>
                        </div>

                        <h6>No Examination Records</h6>

                        <p>No examination marks are currently available for this student.</p>

                    </div>

                <% } %>

            </div>

        </section>


        <!-- ANNUAL ACADEMIC RESULTS -->

        <section class="result-card">

            <div class="result-header annual-header">

                <div class="result-title">

                    <div class="result-title-icon">
                        <i class="bi bi-award"></i>
                    </div>

                    <div>
                        <h5>Annual Academic Results</h5>
                        <p>Year-wise academic performance</p>
                    </div>

                </div>

                <span class="result-count">
                    <%= annualResults ? annualResults.length : 0 %> Records
                </span>

            </div>


            <div class="result-body">

                <% if (annualResults && annualResults.length > 0) { %>

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Academic Year</th>
                                    <th>Class</th>
                                    <th>Marks</th>
                                    <th>Total Marks</th>
                                    <th>Percentage</th>
                                    <th>Result</th>
                                    <th>Finalization</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% annualResults.forEach(result => { %>

                                    <tr>

                                        <td>
                                            <strong><%= result.academic_year %></strong>
                                        </td>

                                        <td>
                                            Class <%= result.class_at_exam %>
                                        </td>

                                        <td>
                                            <span class="marks-value">
                                                <%= result.marks %>
                                            </span>
                                        </td>

                                        <td><%= result.total_marks %></td>

                                        <td>
                                            <span class="percentage-value">
                                                <%= result.total_marks > 0
                                                    ? ((result.marks / result.total_marks) * 100).toFixed(2)
                                                    : '0.00' %>%
                                            </span>
                                        </td>

                                        <td>
                                            <% if (result.status === 'Pass') { %>
                                                <span class="badge badge-pass">
                                                    <i class="bi bi-check-circle me-1"></i>Pass
                                                </span>
                                            <% } else { %>
                                                <span class="badge badge-fail">
                                                    <i class="bi bi-x-circle me-1"></i>Fail
                                                </span>
                                            <% } %>
                                        </td>

                                        <td>
                                            <% if (result.finalized == 1) { %>
                                                <span class="badge badge-finalized">
                                                    <i class="bi bi-check-circle me-1"></i>Finalized
                                                </span>
                                            <% } else { %>
                                                <span class="badge badge-pending">
                                                    <i class="bi bi-clock me-1"></i>Pending
                                                </span>
                                            <% } %>
                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                <% } else { %>

                    <div class="empty-state">

                        <div class="empty-icon">
                            <i class="bi bi-award"></i>
                        </div>

                        <h6>No Annual Results Available</h6>

                        <p>Annual academic results have not been recorded for this student.</p>

                    </div>

                <% } %>

            </div>

        </section>


        <!-- FOOTER -->

        <footer class="page-footer">

            <div class="footer-note">
                <i class="bi bi-shield-check"></i>
                Student information retrieved from EduManage database.
            </div>

            <a href="/admin/index" class="footer-btn">
                <i class="bi bi-arrow-left"></i>
                Back to Students
            </a>

        </footer>

    </main>

</body>
</html>
