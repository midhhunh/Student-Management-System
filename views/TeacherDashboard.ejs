<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Teacher Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>
        <link href="/css/teacherhome.css" rel="stylesheet">
</head>
<body>
<nav class="navbar">
        <div class="container-fluid">
            <a class="navbar-brand" href="/teacher/home">
                <i class="bi bi-mortarboard-fill me-2"></i>
                Teacher Portal
            </a>
        </div>
    </nav>

    <main class="dashboard">

        <div class="welcome-text">
            <h1>Welcome to Your Dashboard!</h1>
            <p>Manage your profile and view your teacher information.</p>
        </div>

        <div class="profile-card">

            <div class="profile-header">
                <div class="profile-icon">
                    <i class="bi bi-person-fill"></i>
                </div>

                <h2>Welcome, <%= teacher.name %></h2>

                <span class="teacher-badge">
                    <i class="bi bi-patch-check-fill me-1"></i>
                    Teacher Account
                </span>
            </div>

            <div class="details">
                <h3 class="details-title">
                    <i class="bi bi-person-vcard-fill me-2"></i>
                    Personal Information
                </h3>

                <div class="row">

                    <div class="col-md-6">
                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div>
                                <span class="detail-label">Teacher ID</span>
                                <div class="detail-value"><%= teacher.teacher_id %></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="bi bi-envelope-fill"></i>
                            </div>
                            <div>
                                <span class="detail-label">Email Address</span>
                                <div class="detail-value"><%= teacher.email %></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <div>
                                <span class="detail-label">Mobile Number</span>
                                <div class="detail-value"><%= teacher.mobile %></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="bi bi-book-fill"></i>
                            </div>
                            <div>
                                <span class="detail-label">Assigned Class</span>
                                <div class="detail-value"><%= teacher.class %></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="detail-item">
                            <div class="detail-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div>
                                <span class="detail-label">Address</span>
                                <div class="detail-value"><%= teacher.address %></div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="dashboard-footer">
                <a href="/teacher/logout" class="logout-btn">
                    <i class="bi bi-box-arrow-right me-2"></i>
                    Logout
                </a>
            </div>

        </div>

    </main>

    <footer>
        &copy; 2026 Student Management System | Teacher Portal
    </footer>
</body>
</html>