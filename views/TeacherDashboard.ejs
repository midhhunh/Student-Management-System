<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Teacher Dashboard | EduManage</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #3730a3;
            --dark: #172554;
            --text: #1e293b;
            --muted: #64748b;
            --border: #e8edf5;
            --surface: #ffffff;
            --background: #f4f7fc;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background: var(--background);
        }

        /* ================= NAVBAR ================= */

        .top-navbar {
            padding: 13px 0;
            background: #172554;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.12);
        }

        .navbar-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
        }

        .navbar-brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            color: white !important;
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.6px;
            text-decoration: none;
        }

        .brand-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
            font-size: 21px;
        }

        .brand-name span {
            color: #a5b4fc;
        }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 17px;
        }

        .portal-label {
            color: #c7d2fe;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .change-password-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 15px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 9px;
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: 0.25s;
        }

        .change-password-link:hover {
            color: white;
            background: #4f46e5;
            border-color: #818cf8;
            transform: translateY(-2px);
        }

        /* ================= MAIN CONTAINER ================= */

        .dashboard {
            width: 100%;
            max-width: 1080px;
            margin: 0 auto;
            padding: 42px 22px;
            flex: 1;
        }

        .breadcrumb {
            margin-bottom: 20px;
            color: #94a3b8;
            font-size: 12px;
        }

        .breadcrumb i {
            margin-right: 5px;
        }

        /* ================= WELCOME BANNER ================= */

        .welcome-banner {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            overflow: hidden;
            margin-bottom: 28px;
            padding: 29px 32px;
            border-radius: 16px;
            color: white;
            background: linear-gradient(115deg, #3730a3, #4f46e5, #6366f1);
            box-shadow: 0 10px 25px rgba(79, 70, 229, 0.15);
        }

        .welcome-banner::after {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            right: -65px;
            top: -125px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 50%;
        }

        .welcome-content {
            position: relative;
            z-index: 1;
        }

        .welcome-label {
            display: inline-block;
            margin-bottom: 10px;
            color: #c7d2fe;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .welcome-banner h1 {
            margin-bottom: 8px;
            font-size: clamp(23px, 4vw, 30px);
            font-weight: 800;
            letter-spacing: -0.8px;
        }

        .welcome-banner p {
            margin: 0;
            color: #e0e7ff;
            font-size: 13px;
        }

        .welcome-decoration {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 75px;
            height: 75px;
            min-width: 75px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.13);
            font-size: 34px;
        }

        /* ================= PROFILE CARD ================= */

        .profile-card {
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 17px;
            background: var(--surface);
            box-shadow: 0 10px 35px rgba(15, 23, 42, 0.045);
        }

        .profile-top {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 28px 32px;
            border-bottom: 1px solid var(--border);
        }

        .profile-avatar {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 76px;
            height: 76px;
            min-width: 76px;
            border: 5px solid #eef2ff;
            border-radius: 20px;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: white;
            font-size: 29px;
            font-weight: 800;
        }

        .profile-name h2 {
            margin-bottom: 7px;
            color: #172554;
            font-size: 21px;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        .profile-name p {
            margin: 0;
            color: var(--muted);
            font-size: 12px;
        }

        .verified-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 10px;
            padding: 6px 10px;
            border-radius: 6px;
            background: #ecfdf5;
            color: #15803d;
            font-size: 10px;
            font-weight: 700;
        }

        /* ================= DETAILS SECTION ================= */

        .details-section {
            padding: 30px 32px;
        }

        .section-heading {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 23px;
        }

        .section-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 39px;
            height: 39px;
            border-radius: 10px;
            background: #eef2ff;
            color: var(--primary);
            font-size: 18px;
        }

        .section-heading h3 {
            margin: 0;
            color: #1e293b;
            font-size: 15px;
            font-weight: 750;
        }

        .section-heading p {
            margin: 4px 0 0;
            color: #94a3b8;
            font-size: 11px;
        }

        /* ================= INFORMATION GRID ================= */

        .details-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .detail-item {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
            min-height: 91px;
            padding: 17px;
            border: 1px solid #edf0f5;
            border-radius: 12px;
            background: #fafbfe;
            transition: 0.25s ease;
        }

        .detail-item:hover {
            border-color: #c7d2fe;
            background: #f5f7ff;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(79, 70, 229, 0.05);
        }

        .detail-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            min-width: 44px;
            border-radius: 12px;
            background: #e9edff;
            color: #4f46e5;
            font-size: 19px;
        }

        .detail-content {
            min-width: 0;
        }

        .detail-label {
            display: block;
            margin-bottom: 6px;
            color: #94a3b8;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .detail-value {
            color: #334155;
            font-size: 13px;
            font-weight: 650;
            overflow-wrap: anywhere;
            line-height: 1.5;
            white-space: pre-wrap;
        }

        .address-item {
            grid-column: span 2;
        }

        .class-badge {
            display: inline-block;
            padding: 5px 11px;
            border-radius: 6px;
            background: #eef2ff;
            color: #4338ca;
            font-size: 12px;
            font-weight: 700;
        }

        .unassigned-badge {
            background: #fff7ed;
            color: #c2410c;
        }

        /* ================= FOOTER ================= */

        .profile-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
            padding: 21px 32px;
            border-top: 1px solid var(--border);
            background: #fbfcfe;
        }

        .footer-note {
            margin: 0;
            color: #94a3b8;
            font-size: 11px;
        }

        .footer-note i {
            color: #16a34a;
        }

        .logout-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 20px;
            border-radius: 9px;
            background: #dc2626;
            color: white;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            transition: 0.25s;
        }

        .logout-btn:hover {
            color: white;
            background: #b91c1c;
            transform: translateY(-2px);
            box-shadow: 0 5px 14px rgba(220, 38, 38, 0.18);
        }

        /* ================= PAGE FOOTER ================= */

        .page-footer {
            padding: 19px 15px;
            border-top: 1px solid #e8edf5;
            background: white;
            color: #94a3b8;
            text-align: center;
            font-size: 11px;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 650px) {

            .navbar-content {
                flex-wrap: wrap;
                gap: 12px;
            }

            .navbar-brand {
                font-size: 19px;
            }

            .navbar-right {
                gap: 8px;
            }

            .portal-label {
                display: none;
            }

            .change-password-link {
                padding: 9px 11px;
                font-size: 11px;
            }

            .dashboard {
                padding: 25px 14px;
            }

            .welcome-banner {
                padding: 24px 20px;
            }

            .welcome-decoration {
                width: 55px;
                height: 55px;
                min-width: 55px;
                font-size: 25px;
            }

            .profile-top {
                padding: 23px 19px;
                gap: 14px;
            }

            .profile-avatar {
                width: 65px;
                height: 65px;
                min-width: 65px;
                font-size: 24px;
            }

            .profile-name h2 {
                font-size: 17px;
            }

            .details-section {
                padding: 24px 18px;
            }

            .details-grid {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .address-item {
                grid-column: span 1;
            }

            .profile-footer {
                padding: 20px;
                align-items: stretch;
                flex-direction: column;
            }

            .logout-btn {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                transition: none !important;
                animation: none !important;
            }
        }
    </style>
</head>

<body>

    <!-- NAVIGATION -->

    <nav class="top-navbar">
        <div class="container navbar-content">

            <a class="navbar-brand" href="/teacher/index">
                <span class="brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>

                <span class="brand-name">
                    Edu<span>Manage</span>
                </span>
            </a>

            <div class="navbar-right">

                <a href="/teacher/change-password"
                   class="change-password-link">

                    <i class="bi bi-key-fill"></i>
                    Change Password

                </a>

                <span class="portal-label">
                    <i class="bi bi-shield-check me-1"></i>
                    TEACHER PORTAL
                </span>

            </div>

        </div>
    </nav>


    <!-- MAIN CONTENT -->

    <main class="dashboard">

        <div class="breadcrumb">
            <i class="bi bi-house-door"></i>
            Teacher Portal
            <i class="bi bi-chevron-right mx-2"></i>
            Dashboard
        </div>


        <!-- WELCOME BANNER -->

        <section class="welcome-banner">

            <div class="welcome-content">

                <span class="welcome-label">
                    TEACHER WORKSPACE
                </span>

                <h1>
                    Welcome back, <%= teacher.name || 'Teacher' %>!
                </h1>

                <p>
                    Manage your profile and stay connected with your class.
                </p>

            </div>

            <div class="welcome-decoration">
                <i class="bi bi-person-workspace"></i>
            </div>

        </section>


        <!-- PROFILE CARD -->

        <section class="profile-card">


            <!-- PROFILE HEADER -->

            <div class="profile-top">

                <div class="profile-avatar">
                    <%= teacher.name
                        ? teacher.name.trim().charAt(0).toUpperCase()
                        : 'T' %>
                </div>

                <div class="profile-name">

                    <h2>
                        <%= teacher.name || 'Teacher Name' %>
                    </h2>

                    <p>
                        <i class="bi bi-person-badge me-1"></i>
                        Teacher ID:
                        <%= teacher.teacher_id || 'Not available' %>
                    </p>

                    <span class="verified-badge">
                        <i class="bi bi-patch-check-fill"></i>
                        Verified Teacher Account
                    </span>

                </div>

            </div>


            <!-- PERSONAL INFORMATION -->

            <div class="details-section">

                <div class="section-heading">

                    <div class="section-icon">
                        <i class="bi bi-person-vcard-fill"></i>
                    </div>

                    <div>
                        <h3>Personal Information</h3>
                        <p>Your registered account information</p>
                    </div>

                </div>


                <div class="details-grid">


                    <!-- TEACHER ID -->

                    <div class="detail-item">

                        <div class="detail-icon">
                            <i class="bi bi-person-badge"></i>
                        </div>

                        <div class="detail-content">

                            <span class="detail-label">
                                Teacher ID
                            </span>

                            <div class="detail-value">
                                <%= teacher.teacher_id || 'Not available' %>
                            </div>

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="detail-item">

                        <div class="detail-icon">
                            <i class="bi bi-envelope-fill"></i>
                        </div>

                        <div class="detail-content">

                            <span class="detail-label">
                                Email Address
                            </span>

                            <div class="detail-value">
                                <%= teacher.email || 'Not available' %>
                            </div>

                        </div>

                    </div>


                    <!-- MOBILE -->

                    <div class="detail-item">

                        <div class="detail-icon">
                            <i class="bi bi-telephone-fill"></i>
                        </div>

                        <div class="detail-content">

                            <span class="detail-label">
                                Mobile Number
                            </span>

                            <div class="detail-value">
                                <%= teacher.mobile || 'Not available' %>
                            </div>

                        </div>

                    </div>


                    <!-- ASSIGNED CLASS -->

                    <div class="detail-item">

                        <div class="detail-icon">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>

                        <div class="detail-content">

                            <span class="detail-label">
                                Assigned Class
                            </span>

                            <% if (teacher.class && String(teacher.class).trim()) { %>

                                <div class="detail-value">
                                    <span class="class-badge">
                                        Class <%= teacher.class %>
                                    </span>
                                </div>

                            <% } else { %>

                                <div class="detail-value">
                                    <span class="class-badge unassigned-badge">
                                        Not Assigned
                                    </span>
                                </div>

                            <% } %>

                        </div>

                    </div>


                    <!-- ADDRESS -->

                    <div class="detail-item address-item">

                        <div class="detail-icon">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>

                        <div class="detail-content">

                            <span class="detail-label">
                                Residential Address
                            </span>

                            <div class="detail-value">
                                <%= teacher.address || 'Address not provided' %>
                            </div>

                        </div>

                    </div>


                </div>

            </div>


            <!-- PROFILE FOOTER -->

            <footer class="profile-footer">

                <p class="footer-note">
                    <i class="bi bi-shield-check me-1"></i>
                    Your profile information is securely managed by EduManage.
                </p>

                <a href="/teacher/logout"
                   class="logout-btn"
                   onclick="return confirm('Are you sure you want to log out?');">

                    <i class="bi bi-box-arrow-right"></i>
                    Logout

                </a>

            </footer>

        </section>

    </main>


    <!-- PAGE FOOTER -->

    <footer class="page-footer">
        &copy; 2026 EduManage Student Management System
        <span class="mx-1">|</span>
        Teacher Portal
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>