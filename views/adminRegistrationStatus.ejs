<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Registration Status | EduManage</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: #f1f5f9;
            color: #1e293b;
        }

        .navbar {
            background: white;
            padding: 16px 0;
            box-shadow: 0 3px 15px rgba(0,0,0,0.05);
        }

        .brand {
            font-size: 23px;
            font-weight: 800;
            color: #2563eb;
            text-decoration: none;
        }

        .brand span {
            color: #7c3aed;
        }

        .main-container {
            max-width: 1150px;
            margin: 45px auto;
            padding: 0 18px;
        }

        .page-title {
            font-size: 26px;
            font-weight: 700;
            color: #172554;
        }

        .page-subtitle {
            color: #64748b;
            font-size: 13px;
        }

        .status-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 17px;
            padding: 23px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
        }

        .status-icon {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-size: 21px;
            background: #fef3c7;
            color: #d97706;
        }

        .status-number {
            font-size: 29px;
            font-weight: 700;
            margin-top: 15px;
        }

        .table-card {
            background: white;
            border-radius: 17px;
            padding: 25px;
            margin-top: 25px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
        }

        .table-title {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .table thead th {
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 15px;
            white-space: nowrap;
        }

        .table tbody td {
            font-size: 13px;
            padding: 15px;
            vertical-align: middle;
        }

        .pending-badge {
            background: #fef3c7;
            color: #b45309;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .empty-message {
            text-align: center;
            padding: 30px;
            color: #94a3b8;
            font-size: 13px;
        }

        .back-btn {
            text-decoration: none;
            background: #eff6ff;
            color: #2563eb;
            padding: 10px 17px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 600;
        }

        @media(max-width: 600px) {
            .main-container {
                margin: 25px auto;
            }

            .table-card {
                padding: 15px;
            }

            .page-title {
                font-size: 21px;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <div class="container d-flex justify-content-between align-items-center">

            <a href="/admin/index" class="brand">
                Edu<span>Manage</span>
            </a>

            <a href="/admin/index" class="back-btn">
                <i class="bi bi-arrow-left me-1"></i>
                Admin
            </a>

        </div>
    </nav>


    <div class="main-container">

        <div class="mb-4">
            <h2 class="page-title">Registration Management</h2>
            <p class="page-subtitle">
                Monitor students and teachers who have not completed registration.
            </p>
        </div>


        <!-- Pending summary -->

        <div class="row g-3">

            <div class="col-md-6">

                <div class="status-card">

                    <div class="status-icon">
                        <i class="bi bi-mortarboard"></i>
                    </div>

                    <div class="status-number text-warning">
                        <%= pendingStudents.length %>
                    </div>

                    <div class="text-secondary small">
                        Pending Student Registrations
                    </div>

                </div>

            </div>


            <div class="col-md-6">

                <div class="status-card">

                    <div class="status-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <div class="status-number text-warning">
                        <%= pendingTeachers.length %>
                    </div>

                    <div class="text-secondary small">
                        Pending Teacher Registrations
                    </div>

                </div>

            </div>

        </div>


        <!-- Pending students -->

        <div class="table-card">

            <h5 class="table-title">
                <i class="bi bi-mortarboard text-primary me-2"></i>
                Pending Student Registrations
            </h5>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Register Number</th>
                            <th>Email</th>
                            <th>Class</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (pendingStudents.length === 0) { %>

                            <tr>
                                <td colspan="4" class="empty-message">
                                    <i class="bi bi-check-circle text-success fs-4 d-block mb-2"></i>
                                    All students have completed registration.
                                </td>
                            </tr>

                        <% } else { %>

                            <% pendingStudents.forEach(student => { %>

                                <tr>
                                    <td>
                                        <strong><%= student.register_number %></strong>
                                    </td>

                                    <td><%= student.email %></td>

                                    <td><%= student.class || "Not Assigned" %></td>

                                    <td>
                                        <span class="pending-badge">
                                            <i class="bi bi-clock me-1"></i>
                                            Pending
                                        </span>
                                    </td>
                                </tr>

                            <% }) %>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>


        <!-- Pending teachers -->

        <div class="table-card">

            <h5 class="table-title">
                <i class="bi bi-person-workspace text-primary me-2"></i>
                Pending Teacher Registrations
            </h5>

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Teacher ID</th>
                            <th>Email</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (pendingTeachers.length === 0) { %>

                            <tr>
                                <td colspan="3" class="empty-message">
                                    <i class="bi bi-check-circle text-success fs-4 d-block mb-2"></i>
                                    All teachers have completed registration.
                                </td>
                            </tr>

                        <% } else { %>

                            <% pendingTeachers.forEach(teacher => { %>

                                <tr>
                                    <td>
                                        <strong><%= teacher.teacher_id %></strong>
                                    </td>

                                    <td><%= teacher.email %></td>

                                    <td>
                                        <span class="pending-badge">
                                            <i class="bi bi-clock me-1"></i>
                                            Pending
                                        </span>
                                    </td>
                                </tr>

                            <% }) %>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</body>
</html>