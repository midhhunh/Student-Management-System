<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
        crossorigin="anonymous"></script>
    <link href="/css/adminhome.css" rel="stylesheet">
    <link href="/css/adminnav.css" rel="stylesheet">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
        <div class="container-fluid px-4">

            <a class="navbar-brand fw-bold" href="/admin/home">
                <span class="logo-icon">🎓</span>
                EduManage
                <span class="admin-badge">ADMIN</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar"
                aria-controls="adminNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link active" href="/admin/home">
                            <i class="bi bi-house-door-fill"></i>
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/admin/about">
                            About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/admin/contact">
                            Contact
                        </a>
                    </li>

                    <li class="nav-item ms-lg-3">
                        <a href="/admin/logout" class="btn btn-logout">
                            <i class="bi bi-box-arrow-right"></i>
                            Logout
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <main class="dashboard-container">

        <!-- Students Table -->
        <section class="table-card">
            <h4 class="mb-3">All Students</h4>

            <div class="table-responsive">
                <table class="table table-bordered table-hover">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Register Number</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>Class</th>
                            <th>Address</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (students && students.length> 0) { %>

                            <% students.forEach(student=> { %>

                                <tr class="clickable-row" tabindex="0" role="link"
                                    onclick="window.location.href='/admin/student/<%= encodeURIComponent(student.register_number) %>'"
                                    onkeydown="if(event.key === 'Enter') window.location.href='/admin/student/<%= encodeURIComponent(student.register_number) %>'">
                                    <td>
                                        <%= student.id %>
                                    </td>
                                    <td>
                                        <%= student.name %>
                                    </td>
                                    <td>
                                        <%= student.register_number %>
                                    </td>
                                    <td>
                                        <%= student.email %>
                                    </td>
                                    <td>
                                        <%= student.mobile %>
                                    </td>
                                    <td>
                                        <%= student.class %>
                                    </td>
                                    <td>
                                        <%= student.address %>
                                    </td>
                                    <td>
                                        <a href="/admin/student/<%= encodeURIComponent(student.register_number) %>/edit"
                                            class="btn btn-warning btn-sm">
                                            Edit
                                        </a>

                                        <form
                                            action="/admin/student/<%= encodeURIComponent(student.register_number) %>/delete"
                                            method="POST" style="display:inline;"
                                            onsubmit="return confirm('Are you sure you want to delete this student?');">

                                            <button type="submit" class="btn btn-danger btn-sm">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                <% }) %>

                                    <% } else { %>

                                        <tr>
                                            <td colspan="8" class="text-center">
                                                No students found
                                            </td>
                                        </tr>

                                        <% } %>
                    </tbody>

                </table>
            </div>
        </section>

        <!-- Teachers Table -->
        <section class="table-card">
            <h4 class="mb-3">All Teachers</h4>

            <div class="d-flex justify-content-between align-items-center mb-3">

                <form action="/admin/add-teacher" method="POST" class="d-flex gap-2">
                    <input type="email" name="email" class="form-control" placeholder="Teacher email" required>

                    <button type="submit" class="btn btn-primary">
                        + Add Teacher
                    </button>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Teacher ID</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>Class Responsibility</th>
                            <th>Address</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (teachers && teachers.length> 0) { %>

                            <% teachers.forEach(teacher=> { %>

                                <tr class="clickable-row" tabindex="0" role="link"
                                    onclick="window.location.href='/admin/teacher/<%= encodeURIComponent(teacher.teacher_id) %>'"
                                    onkeydown="if(event.key === 'Enter') window.location.href='/admin/teacher/<%= encodeURIComponent(teacher.teacher_id) %>'">

                                    <td>
                                        <%= teacher.id %>
                                    </td>

                                    <td>
                                        <a class="profile-link"
                                            href="/admin/teacher/<%= encodeURIComponent(teacher.teacher_id) %>"
                                            onclick="event.stopPropagation()">
                                            <%= teacher.name %>
                                                <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    </td>

                                    <td>
                                        <%= teacher.teacher_id %>
                                    </td>
                                    <td>
                                        <%= teacher.email %>
                                    </td>
                                    <td>
                                        <%= teacher.mobile %>
                                    </td>

                                    <td>
                                        <!-- Prevent clicking the form from opening the profile -->
                                        <form class="d-flex gap-2 align-items-center class-form" method="post"
                                            action="/admin/teacher/<%= encodeURIComponent(teacher.teacher_id) %>/assign-class"
                                            onclick="event.stopPropagation()" onkeydown="event.stopPropagation()">

                                            <select class="form-select form-select-sm" name="class"
                                                aria-label="Class responsibility for <%= teacher.name %>">
                                                <option value="">
                                                    No class assigned
                                                </option>

                                                <% for (let classNumber=1; classNumber <=12; classNumber++) { %>

                                                    <option value="<%= classNumber %>" <%=String(teacher.class || ''
                                                        ).trim()===String(classNumber) ? 'selected' : '' %>
                                                        >
                                                        Class <%= classNumber %>
                                                    </option>

                                                    <% } %>
                                            </select>

                                            <button type="submit" class="btn btn-sm btn-primary text-nowrap">
                                                Save
                                            </button>

                                        </form>
                                    </td>

                                    <td>
                                        <%= teacher.address %>
                                    </td>
                                    <td>
                                        <a href="/admin/teacher/<%= encodeURIComponent(teacher.teacher_id) %>/edit"
                                            class="btn btn-warning btn-sm">
                                            Edit
                                        </a>

                                        <form
                                            action="/admin/teacher/<%= encodeURIComponent(teacher.teacher_id) %>/delete"
                                            method="POST" style="display:inline;"
                                            onsubmit="return confirm('Are you sure you want to delete this Teacher?');">

                                            <button type="submit" class="btn btn-danger btn-sm">
                                                Delete
                                            </button>
                                        </form>
                                    </td>

                                </tr>

                                <% }) %>

                                    <% } else { %>

                                        <tr>
                                            <td colspan="8" class="text-center">
                                                No teachers found
                                            </td>
                                        </tr>

                                        <% } %>
                    </tbody>

                </table>
            </div>
        </section>

    </main>

</body>

</html>