
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard | EduManage</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #3730a3;
            --navy: #111827;
            --text: #1e293b;
            --muted: #64748b;
            --border: #e8edf5;
            --background: #f5f7fb;
            --white: #ffffff;
            --success: #059669;
            --danger: #dc2626;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--background);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
        }

        /* NAVBAR */

        .custom-navbar {
            background: linear-gradient(110deg, #111827, #202b49);
            padding: 14px 0;
            box-shadow: 0 4px 20px rgba(15, 23, 42, 0.12);
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #fff !important;
            font-size: 21px;
            letter-spacing: -0.7px;
        }

        .logo-icon {
            width: 39px;
            height: 39px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            color: white;
            font-size: 20px;
        }

        .admin-badge {
            background: rgba(129, 140, 248, 0.2);
            color: #c7d2fe;
            border: 1px solid rgba(165, 180, 252, 0.25);
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 9px;
            letter-spacing: 1px;
            font-weight: 800;
        }

        .navbar-nav {
            gap: 12px;
        }

        .btn-registration {
            background: #fbbf24;
            color: #422006;
            border: none;
            border-radius: 9px;
            padding: 10px 15px;
            font-weight: 700;
            transition: 0.2s;
        }

        .btn-registration:hover {
            background: #f59e0b;
            color: #422006;
            transform: translateY(-2px);
        }

        .btn-logout {
            color: #fecaca;
            border: 1px solid rgba(248, 113, 113, 0.35);
            border-radius: 9px;
            padding: 9px 15px;
            font-weight: 600;
        }

        .btn-logout:hover {
            background: #dc2626;
            color: white;
        }

        /* MAIN LAYOUT */

        .dashboard-container {
            max-width: 1550px;
            margin: auto;
            padding: 35px 28px 25px;
        }

        .dashboard-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 28px;
        }

        .eyebrow {
            color: var(--primary);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .dashboard-heading h1 {
            font-size: clamp(25px, 3vw, 34px);
            font-weight: 800;
            letter-spacing: -1.3px;
            margin: 7px 0;
            color: #172033;
        }

        .dashboard-heading p {
            color: var(--muted);
            margin: 0;
            font-size: 14px;
        }

        .admin-panel-label {
            display: flex;
            align-items: center;
            gap: 10px;
            background: white;
            border: 1px solid var(--border);
            padding: 12px 17px;
            border-radius: 12px;
            color: #475569;
            font-weight: 600;
            box-shadow: 0 3px 12px rgba(15, 23, 42, 0.03);
        }

        .admin-panel-label i {
            color: var(--success);
            font-size: 19px;
        }

        /* STATISTICS */

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 23px;
            display: flex;
            align-items: center;
            gap: 17px;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.035);
            transition: 0.25s;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 25px rgba(15, 23, 42, 0.08);
        }

        .stat-icon {
            width: 54px;
            height: 54px;
            border-radius: 15px;
            display: grid;
            place-items: center;
            font-size: 24px;
            flex-shrink: 0;
        }

        .student-stat .stat-icon {
            background: #e0e7ff;
            color: #4338ca;
        }

        .teacher-stat .stat-icon {
            background: #d1fae5;
            color: #047857;
        }

        .class-stat .stat-icon {
            background: #fef3c7;
            color: #b45309;
        }

        .stat-card p {
            margin: 0 0 5px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        .stat-card h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -1px;
            color: #172033;
        }

        /* SECTION CARDS */

        .table-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 17px;
            margin-bottom: 27px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.035);
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 23px 25px;
            border-bottom: 1px solid var(--border);
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-icon {
            width: 43px;
            height: 43px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-size: 20px;
        }

        .student-section-icon {
            color: #4338ca;
            background: #eef2ff;
        }

        .teacher-section-icon {
            color: #047857;
            background: #d1fae5;
        }

        .section-heading h2 {
            font-size: 17px;
            font-weight: 800;
            margin: 0 0 5px;
            color: #1e293b;
        }

        .section-heading p {
            color: var(--muted);
            margin: 0;
            font-size: 12px;
        }

        .record-count {
            background: #eef2ff;
            color: #4338ca;
            padding: 7px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        /* SEARCH */

        .table-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 17px 24px;
            background: #fcfdff;
            border-bottom: 1px solid var(--border);
        }

        .search-box {
            width: 100%;
            max-width: 360px;
            position: relative;
        }

        .search-box i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 15px;
        }

        .search-box input {
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            padding: 11px 14px 11px 40px;
            font-size: 12px;
            background: white;
            box-shadow: none;
        }

        .search-box input:focus {
            border-color: #818cf8;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

        /* TABLE */

        .table-responsive {
            padding: 0 20px 12px;
        }

        .data-table {
            margin: 0;
            min-width: 1050px;
            font-size: 12px;
        }

        .data-table thead th {
            color: #64748b;
            background: #f8fafc;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            padding: 15px 12px;
            border-bottom: 1px solid #e8edf5;
            white-space: nowrap;
        }

        .data-table tbody td {
            padding: 15px 12px;
            color: #475569;
            border-bottom: 1px solid #f0f2f6;
            vertical-align: middle;
        }

        .data-table tbody tr:hover {
            background: #fafbff;
        }

        .data-table tbody tr:last-child td {
            border-bottom: none;
        }

        .profile-link {
            color: #27346b;
            text-decoration: none;
            font-weight: 700;
            white-space: nowrap;
        }

        .profile-link:hover {
            color: var(--primary);
        }

        .profile-link i {
            color: #818cf8;
        }

        .id-label {
            display: inline-block;
            background: #f1f5f9;
            color: #475569;
            border-radius: 6px;
            padding: 5px 8px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .class-badge {
            display: inline-block;
            background: #eef2ff;
            color: #4338ca;
            padding: 6px 10px;
            border-radius: 7px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .email-cell {
            min-width: 175px;
        }

        .address-cell {
            min-width: 150px;
            max-width: 220px;
        }

        .action-column {
            text-align: center;
            min-width: 125px;
        }

        .action-buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 7px;
        }

        .action-buttons form {
            margin: 0;
        }

        .action-buttons .btn {
            width: 32px;
            height: 32px;
            padding: 0;
            border-radius: 8px;
            display: grid;
            place-items: center;
            font-size: 13px;
            border: 1px solid transparent;
            transition: 0.2s;
        }

        .btn-edit {
            color: #4338ca;
            background: #eef2ff;
            border-color: #e0e7ff !important;
        }

        .btn-edit:hover {
            background: #4338ca;
            color: white;
        }

        .btn-promote {
            color: #047857;
            background: #d1fae5;
            border-color: #a7f3d0 !important;
        }

        .btn-promote:hover {
            background: #047857;
            color: white;
        }

        .btn-promote:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .btn-delete {
            color: #dc2626;
            background: #fee2e2;
            border-color: #fecaca !important;
        }

        .btn-delete:hover {
            background: #dc2626;
            color: white;
        }

        /* TEACHER GENERATION PANEL */

        .add-teacher-panel {
            margin: 20px 24px;
            padding: 18px;
            background: linear-gradient(110deg, #f0fdf4, #f0fdfa);
            border: 1px solid #bbf7d0;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .add-teacher-description {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .add-teacher-description > i {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 11px;
            background: #d1fae5;
            color: #047857;
            font-size: 20px;
        }

        .add-teacher-description strong {
            color: #14532d;
            font-size: 13px;
        }

        .add-teacher-description p {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 11px;
        }

        .add-teacher-form {
            display: flex;
            gap: 9px;
            width: 48%;
        }

        .add-teacher-form .form-control {
            min-width: 0;
            border: 1px solid #d1e9d8;
            border-radius: 8px;
            font-size: 12px;
            padding: 10px 12px;
            box-shadow: none;
        }

        .add-teacher-form .form-control:focus {
            border-color: #34d399;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
        }

        .btn-add-teacher {
            flex-shrink: 0;
            background: #059669;
            color: white;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 700;
        }

        .btn-add-teacher:hover {
            background: #047857;
            color: white;
        }

        /* CLASS ASSIGNMENT */

        .class-form {
            display: flex;
            align-items: center;
            gap: 6px;
            min-width: 160px;
        }

        .class-form .form-select {
            min-width: 115px;
            border: 1px solid #e2e8f0;
            border-radius: 7px;
            font-size: 10px;
            padding: 7px 25px 7px 8px;
            box-shadow: none;
        }

        .class-form .form-select:focus {
            border-color: #818cf8;
        }

        .btn-save {
            background: #e0e7ff;
            color: #4338ca;
            border: none;
            width: 29px;
            height: 29px;
            display: grid;
            place-items: center;
            border-radius: 7px;
            flex-shrink: 0;
        }

        .btn-save:hover {
            background: #4338ca;
            color: white;
        }

        /* EMPTY STATE */

        .empty-state {
            text-align: center;
            padding: 45px 15px !important;
        }

        .empty-state i {
            display: block;
            color: #a5b4fc;
            font-size: 35px;
            margin-bottom: 12px;
        }

        .empty-state strong {
            display: block;
            color: #334155;
            font-size: 14px;
            margin-bottom: 5px;
        }

        .empty-state span {
            color: #94a3b8;
            font-size: 11px;
        }

        .no-search-results {
            display: none;
            text-align: center;
            color: #94a3b8;
            padding: 25px;
            font-size: 12px;
        }

        /* FOOTER */

        .dashboard-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 20px 5px 5px;
            color: #94a3b8;
            font-size: 11px;
        }

        .dashboard-footer strong {
            color: #64748b;
        }

        /* RESPONSIVE */

        @media (max-width: 992px) {
            .dashboard-container {
                padding: 25px 18px;
            }

            .add-teacher-panel {
                align-items: flex-start;
                flex-direction: column;
            }

            .add-teacher-form {
                width: 100%;
            }
        }

        @media (max-width: 768px) {
            .dashboard-heading {
                align-items: flex-start;
                flex-direction: column;
            }

            .stats-grid {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .stat-card {
                padding: 18px;
            }

            .section-heading {
                padding: 18px;
            }

            .table-toolbar {
                padding: 14px 18px;
            }

            .table-responsive {
                padding: 0 12px 10px;
            }

            .dashboard-footer {
                flex-direction: column;
                align-items: flex-start;
            }

            .navbar-nav {
                align-items: stretch !important;
                padding-top: 15px;
            }

            .navbar-nav .btn {
                width: 100%;
                text-align: center;
            }
        }

        @media (max-width: 480px) {
            .dashboard-container {
                padding: 20px 12px;
            }

            .section-heading {
                align-items: flex-start;
            }

            .record-count {
                font-size: 9px;
            }

            .add-teacher-form {
                flex-direction: column;
            }

            .add-teacher-form button {
                width: 100%;
            }

            .admin-panel-label {
                font-size: 11px;
            }
        }
    </style>
</head>

<body>

    <%
        const studentList = typeof students !== 'undefined' && Array.isArray(students) ? students : [];
        const teacherList = typeof teachers !== 'undefined' && Array.isArray(teachers) ? teachers : [];
    %>

    <!-- NAVIGATION -->
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
        <div class="container-fluid px-3 px-lg-4">

            <a class="navbar-brand fw-bold" href="/admin/index">
                <span class="logo-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
                EduManage
                <span class="admin-badge">ADMIN</span>
            </a>

            <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#adminNavbar"
                aria-controls="adminNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminNavbar">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a href="/admin/registration-status" class="btn btn-registration">
                            <i class="bi bi-person-exclamation me-2"></i>
                            Registration Status
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="/admin/logout" class="btn btn-logout">
                            <i class="bi bi-box-arrow-right me-1"></i>
                            Logout
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <main class="dashboard-container">

        <!-- DASHBOARD HEADING -->
        <section class="dashboard-heading">

            <div>
                <span class="eyebrow">ADMINISTRATION / OVERVIEW</span>

                <h1>Admin Dashboard</h1>

                <p>
                    Welcome to EduManage. Manage your students, teachers and class responsibilities.
                </p>
            </div>

            <div class="admin-panel-label">
                <i class="bi bi-shield-check"></i>
                Administration Panel
            </div>

        </section>

        <!-- STATISTICS -->
        <section class="stats-grid">

            <article class="stat-card student-stat">

                <div class="stat-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div>
                    <p>Total Students</p>
                    <h2><%= studentList.length %></h2>
                </div>

            </article>

            <article class="stat-card teacher-stat">

                <div class="stat-icon">
                    <i class="bi bi-person-workspace"></i>
                </div>

                <div>
                    <p>Total Teachers</p>
                    <h2><%= teacherList.length %></h2>
                </div>

            </article>

            <article class="stat-card class-stat">

                <div class="stat-icon">
                    <i class="bi bi-building"></i>
                </div>

                <div>
                    <p>School Classes</p>
                    <h2>12</h2>
                </div>

            </article>

        </section>

        <!-- STUDENTS SECTION -->
        <section class="table-card">

            <div class="section-heading">

                <div class="section-title">

                    <div class="section-icon student-section-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>

                    <div>
                        <h2>Student Management</h2>
                        <p>View, search and manage registered student records.</p>
                    </div>

                </div>

                <span class="record-count">
                    <%= studentList.length %> Students
                </span>

            </div>

            <!-- STUDENT SEARCH -->
            <div class="table-toolbar">

                <div class="search-box">
                    <i class="bi bi-search"></i>

                    <input type="search"
                        id="studentSearch"
                        class="form-control"
                        placeholder="Search by name, register number, email..."
                        aria-label="Search students">
                </div>

            </div>

            <!-- STUDENT TABLE -->
            <div class="table-responsive">

                <table class="table data-table align-middle" id="studentsTable">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Student Name</th>
                            <th>Register Number</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>Class</th>
                            <th>Address</th>
                            <th class="action-column">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (studentList.length > 0) { %>

                            <% studentList.forEach(student => { %>

                                <tr>

                                    <td><%= student.id %></td>

                                    <td>
                                        <a class="profile-link"
                                            href="/admin/student/<%= encodeURIComponent(student.register_number) %>">

                                            <i class="bi bi-person-circle me-1"></i>
                                            <%= student.name %>

                                        </a>
                                    </td>

                                    <td>
                                        <span class="id-label">
                                            <%= student.register_number %>
                                        </span>
                                    </td>

                                    <td class="email-cell">
                                        <%= student.email %>
                                    </td>

                                    <td>
                                        <%= student.mobile || '—' %>
                                    </td>

                                    <td>
                                        <span class="class-badge">
                                            <%= student.class ? 'Class ' + student.class : 'Unassigned' %>
                                        </span>
                                    </td>

                                    <td class="address-cell">
                                        <%= student.address || '—' %>
                                    </td>

                                    <td class="action-column">

                                        <div class="action-buttons">

                                            <!-- EDIT -->
                                            <a href="/admin/student/<%= encodeURIComponent(student.register_number) %>/edit"
                                                class="btn btn-edit"
                                                title="Edit student"
                                                aria-label="Edit student">

                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <!-- PROMOTE -->
                                            <form
                                                action="/admin/student/<%= encodeURIComponent(student.register_number) %>/promote"
                                                method="POST"
                                                class="promote-form"
                                                data-student-name="<%= student.name %>">

                                                <button type="submit"
                                                    class="btn btn-promote"
                                                    title="Promote student"
                                                    aria-label="Promote student"
                                                    <%= Number(student.class) >= 12 ? 'disabled' : '' %>>

                                                    <i class="bi bi-arrow-up-circle"></i>
                                                </button>

                                            </form>

                                            <!-- DELETE -->
                                            <form
                                                action="/admin/student/<%= encodeURIComponent(student.register_number) %>/delete"
                                                method="POST"
                                                class="delete-student-form"
                                                data-student-name="<%= student.name %>">

                                                <button type="submit"
                                                    class="btn btn-delete"
                                                    title="Delete student"
                                                    aria-label="Delete student">

                                                    <i class="bi bi-trash3"></i>
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }); %>

                        <% } else { %>

                            <tr>
                                <td colspan="8" class="empty-state">

                                    <i class="bi bi-person-x"></i>

                                    <strong>No students found</strong>

                                    <span>
                                        Student records will appear here after registration.
                                    </span>

                                </td>
                            </tr>

                        <% } %>

                    </tbody>

                </table>

                <div id="studentNoResults" class="no-search-results">
                    <i class="bi bi-search me-1"></i>
                    No matching students found.
                </div>

            </div>

        </section>

        <!-- TEACHERS SECTION -->
        <section class="table-card">

            <div class="section-heading">

                <div class="section-title">

                    <div class="section-icon teacher-section-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <div>
                        <h2>Teacher Management</h2>
                        <p>Manage teacher profiles and class responsibilities.</p>
                    </div>

                </div>

                <span class="record-count">
                    <%= teacherList.length %> Teachers
                </span>

            </div>

            <!-- GENERATE TEACHER ID -->
            <div class="add-teacher-panel">

                <div class="add-teacher-description">

                    <i class="bi bi-person-plus-fill"></i>

                    <div>
                        <strong>Generate Teacher ID</strong>

                        <p>
                            Enter a teacher's email address to generate a registration ID.
                        </p>
                    </div>

                </div>

                <form action="/admin/add-teacher"
                    method="POST"
                    class="add-teacher-form">

                    <input type="email"
                        name="email"
                        class="form-control"
                        placeholder="Enter teacher email address"
                        aria-label="Teacher email"
                        maxlength="254"
                        required>

                    <button type="submit" class="btn btn-add-teacher">

                        <i class="bi bi-plus-lg me-1"></i>
                        Generate ID

                    </button>

                </form>

            </div>

            <!-- TEACHER SEARCH -->
            <div class="table-toolbar">

                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="search"
                        id="teacherSearch"
                        class="form-control"
                        placeholder="Search by name, teacher ID, email..."
                        aria-label="Search teachers">

                </div>

            </div>

            <!-- TEACHER TABLE -->
            <div class="table-responsive">

                <table class="table data-table align-middle" id="teachersTable">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Teacher Name</th>
                            <th>Teacher ID</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>Class Responsibility</th>
                            <th>Address</th>
                            <th class="action-column">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (teacherList.length > 0) { %>

                            <% teacherList.forEach(teacher => { %>

                                <tr>

                                    <td><%= teacher.id %></td>

                                    <td>

                                        <a class="profile-link"
                                            href="/admin/teacher/<%= encodeURIComponent(teacher.teacher_id) %>">

                                            <i class="bi bi-person-badge me-1"></i>
                                            <%= teacher.name %>

                                        </a>

                                    </td>

                                    <td>
                                        <span class="id-label">
                                            <%= teacher.teacher_id %>
                                        </span>
                                    </td>

                                    <td class="email-cell">
                                        <%= teacher.email %>
                                    </td>

                                    <td>
                                        <%= teacher.mobile || '—' %>
                                    </td>

                                    <!-- ASSIGN CLASS -->
                                    <td>

                                        <form class="class-form"
                                            method="POST"
                                            action="/admin/teacher/<%= encodeURIComponent(teacher.teacher_id) %>/assign-class">

                                            <select class="form-select form-select-sm"
                                                name="class"
                                                aria-label="Class responsibility for <%= teacher.name %>">

                                                <option value=""
                                                    <%= !teacher.class ? 'selected' : '' %>>

                                                    No class assigned

                                                </option>

                                                <% for (let classNumber = 1; classNumber <= 12; classNumber++) { %>

                                                    <option value="<%= classNumber %>"
                                                        <%= String(teacher.class || '').trim() === String(classNumber) ? 'selected' : '' %>>

                                                        Class <%= classNumber %>

                                                    </option>

                                                <% } %>

                                            </select>

                                            <button type="submit"
                                                class="btn btn-save"
                                                title="Save class responsibility"
                                                aria-label="Save class responsibility">

                                                <i class="bi bi-check-lg"></i>

                                            </button>

                                        </form>

                                    </td>

                                    <td class="address-cell">
                                        <%= teacher.address || '—' %>
                                    </td>

                                    <td class="action-column">

                                        <div class="action-buttons">

                                            <!-- EDIT -->
                                            <a href="/admin/teacher/<%= encodeURIComponent(teacher.teacher_id) %>/edit"
                                                class="btn btn-edit"
                                                title="Edit teacher"
                                                aria-label="Edit teacher">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <!-- DELETE -->
                                            <form
                                                action="/admin/teacher/<%= encodeURIComponent(teacher.teacher_id) %>/delete"
                                                method="POST"
                                                class="delete-teacher-form"
                                                data-teacher-name="<%= teacher.name %>">

                                                <button type="submit"
                                                    class="btn btn-delete"
                                                    title="Delete teacher"
                                                    aria-label="Delete teacher">

                                                    <i class="bi bi-trash3"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }); %>

                        <% } else { %>

                            <tr>
                                <td colspan="8" class="empty-state">

                                    <i class="bi bi-person-workspace"></i>

                                    <strong>No teachers found</strong>

                                    <span>
                                        Registered teachers will appear here.
                                    </span>

                                </td>
                            </tr>

                        <% } %>

                    </tbody>

                </table>

                <div id="teacherNoResults" class="no-search-results">
                    <i class="bi bi-search me-1"></i>
                    No matching teachers found.
                </div>

            </div>

        </section>

        <!-- FOOTER -->
        <footer class="dashboard-footer">

            <span>
                © <%= new Date().getFullYear() %>
                <strong>EduManage</strong>. All rights reserved.
            </span>

            <span>
                <i class="bi bi-shield-check me-1"></i>
                Student Management System
            </span>

        </footer>

    </main>

    <!-- JAVASCRIPT -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        // TABLE SEARCH
        function addTableSearch(inputId, tableId, noResultsId) {

            const searchInput = document.getElementById(inputId);
            const table = document.getElementById(tableId);
            const noResults = document.getElementById(noResultsId);

            if (!searchInput || !table) return;

            searchInput.addEventListener("input", function () {

                const searchText = this.value.toLowerCase().trim();

                const rows = table.querySelectorAll("tbody tr");

                let visibleRows = 0;

                rows.forEach(function (row) {

                    // Ignore the original empty-state row
                    if (row.querySelector(".empty-state")) return;

                    const rowText = row.innerText.toLowerCase();

                    const matches = rowText.includes(searchText);

                    row.style.display = matches ? "" : "none";

                    if (matches) {
                        visibleRows++;
                    }

                });

                if (noResults) {
                    noResults.style.display =
                        searchText !== "" && visibleRows === 0 ? "block" : "none";
                }

            });

        }

        addTableSearch(
            "studentSearch",
            "studentsTable",
            "studentNoResults"
        );

        addTableSearch(
            "teacherSearch",
            "teachersTable",
            "teacherNoResults"
        );


        // STUDENT PROMOTION CONFIRMATION
        document.querySelectorAll(".promote-form").forEach(function (form) {

            form.addEventListener("submit", function (event) {

                const studentName = this.dataset.studentName || "this student";

                const confirmed = confirm(
                    "Are you sure you want to promote " +
                    studentName +
                    " to the next class?"
                );

                if (!confirmed) {
                    event.preventDefault();
                }

            });

        });


        // STUDENT DELETE CONFIRMATION
        document.querySelectorAll(".delete-student-form").forEach(function (form) {

            form.addEventListener("submit", function (event) {

                const studentName = this.dataset.studentName || "this student";

                const confirmed = confirm(
                    "Are you sure you want to permanently delete " +
                    studentName +
                    "?"
                );

                if (!confirmed) {
                    event.preventDefault();
                }

            });

        });


        // TEACHER DELETE CONFIRMATION
        document.querySelectorAll(".delete-teacher-form").forEach(function (form) {

            form.addEventListener("submit", function (event) {

                const teacherName = this.dataset.teacherName || "this teacher";

                const confirmed = confirm(
                    "Are you sure you want to permanently delete " +
                    teacherName +
                    "?"
                );

                if (!confirmed) {
                    event.preventDefault();
                }

            });

        });

    </script>

</body>
</html>