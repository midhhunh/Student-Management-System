<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Student | EduManage</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link href="/css/edit-s.css" rel="stylesheet">
</head>

<body>

    <nav class="topbar">
        <div class="container topbar-content">
            <a href="/teacher/home" class="brand">
                <span class="brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
                <span>EduManage</span>
            </a>

            <a href="/teacher/home" class="back-link">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Teacher Home</span>
            </a>
        </div>
    </nav>

    <main class="container page-container">

        <div class="page-heading">
            <p class="eyebrow">TEACHER PORTAL</p>
            <h1>Update Student Details</h1>
            <p>
                Edit the student's personal information and save your changes.
            </p>
        </div>

        <section class="edit-card">

            <div class="card-heading">
                <div class="edit-icon">
                    <i class="bi bi-person-gear"></i>
                </div>

                <div>
                    <h2>Edit Student</h2>
                    <p>Update the details of the student in your assigned class.</p>
                </div>
            </div>

            <div class="student-reference">
                <i class="bi bi-person-vcard"></i>

                <div>
                    <span>Register Number</span>
                    <strong><%= student.register_number %></strong>
                </div>

                <span class="status-badge">
                    <i class="bi bi-check-circle-fill"></i> Student Record
                </span>
            </div>

            <form
                action="/teacher/student/<%= encodeURIComponent(student.register_number) %>/edit"
                method="POST"
                id="editStudentForm">

                <div class="form-section-title">
                    <i class="bi bi-person-lines-fill"></i>
                    Personal Information
                </div>

                <div class="row g-4">

                    <div class="col-12">
                        <label for="register_number" class="form-label">
                            Register Number
                        </label>

                        <input
                            type="text"
                            id="register_number"
                            class="form-control readonly-field"
                            value="<%= student.register_number %>"
                            readonly>

                        <div class="form-text">
                            The register number cannot be changed here.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="name" class="form-label">
                            Full Name <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">
                            <i class="bi bi-person input-icon"></i>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                class="form-control with-icon"
                                value="<%= student.name %>"
                                placeholder="Enter student's full name"
                                minlength="2"
                                maxlength="100"
                                autocomplete="name"
                                required>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="email" class="form-label">
                            Email Address <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">
                            <i class="bi bi-envelope input-icon"></i>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="form-control with-icon"
                                value="<%= student.email %>"
                                placeholder="student@example.com"
                                maxlength="254"
                                autocomplete="email"
                                required>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="mobile" class="form-label">
                            Mobile Number <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">
                            <i class="bi bi-telephone input-icon"></i>

                            <input
                                type="tel"
                                id="mobile"
                                name="mobile"
                                class="form-control with-icon"
                                value="<%= student.mobile %>"
                                placeholder="Enter mobile number"
                                pattern="[0-9]{10}"
                                minlength="10"
                                maxlength="10"
                                inputmode="numeric"
                                autocomplete="tel"
                                title="Enter a 10-digit mobile number"
                                required>
                        </div>

                        <div class="form-text">
                            Enter a 10-digit mobile number.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="class" class="form-label">
                            Current Class
                        </label>

                        <div class="input-wrapper">
                            <i class="bi bi-mortarboard input-icon"></i>

                            <input
                                type="text"
                                id="class"
                                class="form-control with-icon readonly-field"
                                value="<%= student.class || 'Not assigned' %>"
                                readonly>
                        </div>

                        <div class="form-text">
                            Only the administrator can change a student's class.
                        </div>
                    </div>

                    <div class="col-12">
                        <label for="address" class="form-label">
                            Residential Address <span class="required">*</span>
                        </label>

                        <div class="input-wrapper textarea-wrapper">
                            <i class="bi bi-geo-alt input-icon"></i>

                            <textarea
                                id="address"
                                name="address"
                                class="form-control with-icon"
                                rows="4"
                                maxlength="500"
                                placeholder="Enter student's residential address"
                                required><%= student.address %></textarea>
                        </div>
                    </div>

                </div>

                <div class="form-notice">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>
                        Please check the information before saving.
                        The changes will update the student's record.
                    </span>
                </div>

                <div class="form-actions">
                    <a href="/teacher/home" class="btn btn-cancel">
                        <i class="bi bi-x-circle"></i>
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-save" id="saveButton">
                        <i class="bi bi-check-circle"></i>
                        Save Changes
                    </button>
                </div>

            </form>
        </section>

        <footer class="page-footer">
            &copy; <%= new Date().getFullYear() %> EduManage
            <span>·</span> Student Management System
        </footer>

    </main>

    <script>
        const form = document.getElementById("editStudentForm");
        const mobileInput = document.getElementById("mobile");
        const saveButton = document.getElementById("saveButton");

        mobileInput.addEventListener("input", function () {
            this.value = this.value.replace(/\D/g, "").slice(0, 10);
        });

        form.addEventListener("submit", function (event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                form.reportValidity();
                return;
            }

            saveButton.disabled = true;
            saveButton.innerHTML =
                '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving...';
        });
    </script>

</body>
</html>